{
  "meta": {
    "filename": "diff_base.json",
    "description": "Defines how our wgpu-py base API differs from the web-api (the one derived from webgpu.idl).",
    "notes": "We mostly *remove* things that we cannot replicate on desktop. So that we get an API surface that is the intersection of what we can use on desktop and web."
  },
  "classes": {
    "GPUQueue": {
      "methods": {
        "copy_external_image_to_texture": { "diff": "REMOVE" }
      }
    },
    "GPUDevice": {
      "methods": {
        "import_external_texture": { "diff": "REMOVE" }
      }
    },
    "NavigatorGPU": { "diff": "REMOVE" },
    "GPUExternalTexture": { "diff": "REMOVE" },
    "GPUUncapturedErrorEvent": { "diff": "REMOVE" },
    "GPUSupportedLimits": { "diff": "REMOVE" },
    "GPUSupportedFeatures": { "diff": "REMOVE" },
    "WGSLLanguageFeatures": { "diff": "REMOVE" }
  },
  "structs": {
    "ExternalTextureBindingLayout": { "diff": "REMOVE" },
    "CopyExternalImageDestInfo": { "diff": "REMOVE" },
    "CopyExternalImageSourceInfo": { "diff": "REMOVE" },
    "BindGroupLayoutEntry": {
      "fields": {
        "external_texture": { "diff": "REMOVE" }
      }
    }
  }
}
