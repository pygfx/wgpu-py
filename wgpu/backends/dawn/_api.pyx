cdef int _fill_programmable_stage(
    _Arena arena, dict_or_struct, WGPUShaderModule* module, WGPUStringView* entry_point,
    size_t* constant_count, const WGPUConstantEntry** constants
) except -1:
    cdef WGPUConstantEntry* c_constants
    cdef size_t i
    stage = dict_or_struct
    module[0] = <WGPUShaderModule>_ptr(stage["module"])
    entry_point[0] = arena.sv(stage.get("entry_point"))
    consts = stage.get("constants") or {}
    c_constants = <WGPUConstantEntry*>arena.alloc(len(consts) * sizeof(WGPUConstantEntry))
    for i, (key, value) in enumerate(consts.items()):
        assert isinstance(key, (str, int))
        assert isinstance(value, (int, float, bool))
        c_constants[i] = WGPU_CONSTANT_ENTRY_INIT
        c_constants[i].key = arena.sv(str(key))
        c_constants[i].value = float(value)
    constant_count[0] = len(consts)
    constants[0] = c_constants
    return 0


cdef int _fill_compute_pipeline_descriptor(
    WGPUComputePipelineDescriptor* desc, _Arena arena, label, layout, compute
) except -1:
    check_struct("ProgrammableStage", compute)
    desc.label = arena.sv(label)
    if isinstance(layout, GPUPipelineLayout):
        desc.layout = <WGPUPipelineLayout>_ptr(layout)
    elif layout == enums.AutoLayoutMode.auto:
        desc.layout = NULL
    else:
        raise TypeError(
            "create_compute_pipeline() 'layout' arg must be a GPUPipelineLayout or 'auto'"
        )
    _fill_programmable_stage(
        arena,
        compute,
        &desc.compute.module,
        &desc.compute.entryPoint,
        &desc.compute.constantCount,
        &desc.compute.constants,
    )
    return 0


cdef int _fill_render_pipeline_descriptor(
    WGPURenderPipelineDescriptor* desc,
    _Arena arena,
    label,
    layout,
    vertex,
    primitive,
    depth_stencil,
    multisample,
    fragment,
) except -1:
    cdef WGPUVertexBufferLayout* c_buffers
    cdef WGPUVertexAttribute* c_attributes
    cdef WGPUDepthStencilState* c_ds
    cdef WGPUFragmentState* c_fragment
    cdef WGPUColorTargetState* c_targets
    cdef WGPUBlendState* c_blend
    cdef WGPUStencilFaceState* c_face
    cdef WGPUBlendComponent* c_comp
    cdef size_t i, j

    primitive = primitive or {}
    multisample = multisample or {}
    depth_stencil = depth_stencil or {}
    check_struct("VertexState", vertex)
    check_struct("DepthStencilState", depth_stencil)
    check_struct("MultisampleState", multisample)
    check_struct("PrimitiveState", primitive)

    desc.label = arena.sv(label)
    if isinstance(layout, GPUPipelineLayout):
        desc.layout = <WGPUPipelineLayout>_ptr(layout)
    elif layout == enums.AutoLayoutMode.auto:
        desc.layout = NULL
    else:
        raise TypeError(
            "create_render_pipeline() 'layout' arg must be a GPUPipelineLayout or 'auto'"
        )

    # Vertex state
    _fill_programmable_stage(
        arena,
        vertex,
        &desc.vertex.module,
        &desc.vertex.entryPoint,
        &desc.vertex.constantCount,
        &desc.vertex.constants,
    )
    buffers = vertex.get("buffers", ())
    c_buffers = <WGPUVertexBufferLayout*>arena.alloc(len(buffers) * sizeof(WGPUVertexBufferLayout))
    for i in range(len(buffers)):
        buffer_des = buffers[i]
        c_buffers[i] = WGPU_VERTEX_BUFFER_LAYOUT_INIT
        attributes = buffer_des["attributes"]
        c_attributes = <WGPUVertexAttribute*>arena.alloc(len(attributes) * sizeof(WGPUVertexAttribute))
        for j in range(len(attributes)):
            attribute = attributes[j]
            c_attributes[j] = WGPU_VERTEX_ATTRIBUTE_INIT
            c_attributes[j].format = <WGPUVertexFormat>_enum("VertexFormat", attribute["format"])
            c_attributes[j].offset = attribute["offset"]
            c_attributes[j].shaderLocation = attribute["shader_location"]
        c_buffers[i].arrayStride = buffer_des["array_stride"]
        c_buffers[i].stepMode = <WGPUVertexStepMode>_enum(
            "VertexStepMode", buffer_des.get("step_mode", "vertex")
        )
        c_buffers[i].attributeCount = len(attributes)
        c_buffers[i].attributes = c_attributes
    desc.vertex.bufferCount = len(buffers)
    desc.vertex.buffers = c_buffers

    # Primitive state
    desc.primitive.topology = <WGPUPrimitiveTopology>_enum(
        "PrimitiveTopology", primitive.get("topology", "triangle-list")
    )
    strip_index_format = primitive.get("strip_index_format", None)
    if strip_index_format:
        desc.primitive.stripIndexFormat = <WGPUIndexFormat>_enum("IndexFormat", strip_index_format)
    desc.primitive.frontFace = <WGPUFrontFace>_enum("FrontFace", primitive.get("front_face", "ccw"))
    desc.primitive.cullMode = <WGPUCullMode>_enum("CullMode", primitive.get("cull_mode", "none"))
    desc.primitive.unclippedDepth = bool(primitive.get("unclipped_depth", False))

    # Depth stencil state
    if depth_stencil:
        if depth_stencil.get("format", None) is None:
            raise ValueError("depth_stencil needs format")
        c_ds = <WGPUDepthStencilState*>arena.alloc(sizeof(WGPUDepthStencilState))
        c_ds[0] = WGPU_DEPTH_STENCIL_STATE_INIT
        c_ds.format = <WGPUTextureFormat>_enum("TextureFormat", depth_stencil["format"])
        c_ds.depthWriteEnabled = (
            WGPUOptionalBool_True
            if depth_stencil.get("depth_write_enabled", False)
            else WGPUOptionalBool_False
        )
        c_ds.depthCompare = <WGPUCompareFunction>_enum(
            "CompareFunction", depth_stencil.get("depth_compare", "always")
        )
        for face_key in ("stencil_front", "stencil_back"):
            face = depth_stencil.get(face_key, {})
            check_struct("StencilFaceState", face)
            c_face = (
                &c_ds.stencilFront if face_key == "stencil_front" else &c_ds.stencilBack
            )
            c_face.compare = <WGPUCompareFunction>_enum("CompareFunction", face.get("compare", "always"))
            c_face.failOp = <WGPUStencilOperation>_enum("StencilOperation", face.get("fail_op", "keep"))
            c_face.depthFailOp = <WGPUStencilOperation>_enum(
                "StencilOperation", face.get("depth_fail_op", "keep")
            )
            c_face.passOp = <WGPUStencilOperation>_enum("StencilOperation", face.get("pass_op", "keep"))
        c_ds.stencilReadMask = depth_stencil.get("stencil_read_mask", 0xFFFFFFFF)
        c_ds.stencilWriteMask = depth_stencil.get("stencil_write_mask", 0xFFFFFFFF)
        c_ds.depthBias = depth_stencil.get("depth_bias", 0)
        c_ds.depthBiasSlopeScale = depth_stencil.get("depth_bias_slope_scale", 0)
        c_ds.depthBiasClamp = depth_stencil.get("depth_bias_clamp", 0)
        desc.depthStencil = c_ds

    # Multisample state
    desc.multisample.count = multisample.get("count", 1)
    desc.multisample.mask = multisample.get("mask", 0xFFFFFFFF)
    desc.multisample.alphaToCoverageEnabled = bool(
        multisample.get("alpha_to_coverage_enabled", False)
    )

    # Fragment state
    if fragment is not None:
        check_struct("FragmentState", fragment)
        c_fragment = <WGPUFragmentState*>arena.alloc(sizeof(WGPUFragmentState))
        c_fragment[0] = WGPU_FRAGMENT_STATE_INIT
        _fill_programmable_stage(
            arena,
            fragment,
            &c_fragment.module,
            &c_fragment.entryPoint,
            &c_fragment.constantCount,
            &c_fragment.constants,
        )
        targets = fragment["targets"]
        c_targets = <WGPUColorTargetState*>arena.alloc(len(targets) * sizeof(WGPUColorTargetState))
        for i in range(len(targets)):
            target = targets[i]
            c_targets[i] = WGPU_COLOR_TARGET_STATE_INIT
            c_targets[i].format = <WGPUTextureFormat>_enum("TextureFormat", target["format"])
            c_targets[i].writeMask = target.get("write_mask", 0xF)
            blend = target.get("blend", None)
            if blend:
                c_blend = <WGPUBlendState*>arena.alloc(sizeof(WGPUBlendState))
                c_blend[0] = WGPU_BLEND_STATE_INIT
                for comp_key in ("color", "alpha"):
                    comp = blend[comp_key]
                    c_comp = &c_blend.color if comp_key == "color" else &c_blend.alpha
                    c_comp.srcFactor = <WGPUBlendFactor>_enum("BlendFactor", comp.get("src_factor", "one"))
                    c_comp.dstFactor = <WGPUBlendFactor>_enum("BlendFactor", comp.get("dst_factor", "zero"))
                    c_comp.operation = <WGPUBlendOperation>_enum(
                        "BlendOperation", comp.get("operation", "add")
                    )
                c_targets[i].blend = c_blend
        c_fragment.targetCount = len(targets)
        c_fragment.targets = c_targets
        desc.fragment = c_fragment
    return 0


class GPUBuffer(classes.GPUBuffer, GPUObjectBase):
    # In Pyodide: the address of the copy of the mapped range in the wasm heap
    _web_mapped_ptr = 0

    def _release_ptr(self, ptr):
        wgpuBufferRelease(<WGPUBuffer><uintptr_t>ptr)

    def __init__(self, label, internal, device, size, usage, map_state):
        super().__init__(label, internal, device, size, usage, map_state)
        self._mapped_status = 0, 0, 0
        self._mapped_memoryviews = []
        if self._map_state == enums.BufferMapState.mapped:
            self._mapped_status = 0, self.size, flags.MapMode.WRITE

    def _check_range(self, offset, size):
        if offset is None:
            offset = 0
            if self._mapped_status[2] != 0:
                offset = self._mapped_status[0]
        else:
            offset = int(offset)
        if size is None:
            size = self.size - offset
            if self._mapped_status[2] != 0:
                size = self._mapped_status[1] - offset
        else:
            size = int(size)
        if offset < 0:
            raise ValueError("Mapped offset must not be smaller than zero.")
        if offset % 8:
            raise ValueError("Mapped offset must be a multiple of 8.")
        if size < 1:
            raise ValueError("Mapped size must be larger than zero.")
        if size % 4:
            raise ValueError("Mapped size must be a multiple of 4.")
        if offset + size > self.size:
            raise ValueError("Mapped range must not extend beyond total buffer size.")
        return offset, size

    def map_async(self, mode: flags.MapModeFlags, offset: int = 0, size: int | None = None) -> GPUPromise[None]:
        cdef WGPUBufferMapCallbackInfo cb = WGPU_BUFFER_MAP_CALLBACK_INFO_INIT
        cdef WGPUFuture future

        if isinstance(mode, str):
            if mode == "READ_NOSYNC":  # for compatibility with the wgpu-native backend
                mode = "READ"
            mode = str_flag_to_int(flags.MapMode, mode)
        map_mode = int(mode)
        offset, size = self._check_range(offset, size)

        if self._map_state != enums.BufferMapState.unmapped:
            promise = GPUPromise("buffer.map", None)
            promise._wgpu_set_error(
                RuntimeError(
                    f"Can only map a buffer if its currently unmapped, not {self._map_state!r}"
                )
            )
            return promise

        def handler(_):
            self._map_state = enums.BufferMapState.mapped
            self._mapped_status = offset, offset + size, map_mode
            self._mapped_memoryviews = []
            self._web_mapped_ptr = 0

        promise = GPUPromise("buffer.map", handler)
        cb.mode = _CALLBACK_MODE
        cb.callback = _buffer_map_callback
        cb.userdata1 = _promise_userdata(promise)
        self._map_state = enums.BufferMapState.pending
        future = wgpuBufferMapAsync(
            <WGPUBuffer>_self_ptr(self), map_mode, offset, size, cb
        )
        try:
            _check()
        except Exception:
            self._map_state = enums.BufferMapState.unmapped
            raise
        promise._set_future(future.id)
        return promise

    def unmap(self) -> None:
        if self._map_state != enums.BufferMapState.mapped:
            raise RuntimeError("Can only unmap a buffer if its currently mapped.")
        self._release_memoryviews()
        wgpuBufferUnmap(<WGPUBuffer>_self_ptr(self))
        _check()
        self._map_state = enums.BufferMapState.unmapped
        self._mapped_status = 0, 0, 0
        self._web_mapped_ptr = 0  # freed by Emdawnwebgpu on unmap

    def _release_memoryviews(self):
        for m in self._mapped_memoryviews:
            try:
                m.release()
            except Exception:  # no-cover
                pass
        self._mapped_memoryviews = []

    def _get_web_mapped_ptr(self, offset):
        """Get the address (in the wasm heap) for the given offset in the mapped range.

        Emdawnwebgpu copies a mapped range between the JS ArrayBuffer and the
        wasm heap each time it is accessed (and back on unmap, when writing),
        and the browser does not allow overlapping ranges. So we obtain the
        whole mapped range once, on first access.
        """
        cdef void* ptr
        if not self._web_mapped_ptr:
            start, end, mode = self._mapped_status
            if mode & flags.MapMode.WRITE:
                ptr = wgpuBufferGetMappedRange(<WGPUBuffer>_self_ptr(self), start, end - start)
            else:
                ptr = <void*>wgpuBufferGetConstMappedRange(
                    <WGPUBuffer>_self_ptr(self), start, end - start
                )
            _check()
            if ptr == NULL:
                raise RuntimeError("Could not get mapped range.")
            self._web_mapped_ptr = <uintptr_t>ptr
        return self._web_mapped_ptr + offset - self._mapped_status[0]

    def read_mapped(self, buffer_offset: int | None = None, size: int | None = None, *, copy: bool = True):
        cdef const void* ptr
        cdef WGPUStatus status
        cdef char* dst
        if self._map_state != enums.BufferMapState.mapped:
            raise RuntimeError("Can only read from a buffer if its mapped.")
        elif not (self._mapped_status[2] & flags.MapMode.READ):
            raise RuntimeError("Can only read from a buffer if its mapped in read mode.")
        offset, size = self._check_range(buffer_offset, size)
        if offset < self._mapped_status[0] or (offset + size) > self._mapped_status[1]:
            raise ValueError(
                "The range for buffer reading is not contained in the currently mapped range."
            )
        if _IS_EMSCRIPTEN:
            ptr = <const void*><uintptr_t>self._get_web_mapped_ptr(offset)
            if copy:
                return memoryview(PyByteArray_FromStringAndSize(<const char*>ptr, size)).cast("B")
            data = PyMemoryView_FromMemory(<char*>ptr, size, PyBUF_READ)
            self._mapped_memoryviews.append(data)
            return data
        if copy:
            # Copy into a new bytearray (a single copy)
            data = PyByteArray_FromStringAndSize(NULL, size)
            dst = data
            status = wgpuBufferReadMappedRange(<WGPUBuffer>_self_ptr(self), offset, dst, size)
            _check()
            if status != WGPUStatus_Success:
                raise RuntimeError("Could not read mapped buffer.")
            return memoryview(data).cast("B")
        ptr = wgpuBufferGetConstMappedRange(<WGPUBuffer>_self_ptr(self), offset, size)
        _check()
        if ptr == NULL:
            raise RuntimeError("Could not get mapped range.")
        data = PyMemoryView_FromMemory(<char*>ptr, size, PyBUF_READ)
        self._mapped_memoryviews.append(data)
        return data

    def write_mapped(self, data, buffer_offset: int | None = None) -> None:
        cdef void* ptr
        cdef _Buffer buf
        cdef WGPUStatus status
        if self._map_state != enums.BufferMapState.mapped:
            raise RuntimeError("Can only write to a buffer if its mapped.")
        elif not (self._mapped_status[2] & flags.MapMode.WRITE):
            raise RuntimeError("Can only write from a buffer if its mapped in write mode.")
        buf = _Buffer(data)
        nbytes = buf.view.len
        size = (nbytes + 3) & ~3
        offset, size = self._check_range(buffer_offset, size)
        if offset < self._mapped_status[0] or (offset + size) > self._mapped_status[1]:
            raise ValueError(
                "The range for buffer writing is not contained in the currently mapped range."
            )
        if _IS_EMSCRIPTEN:
            ptr = <void*><uintptr_t>self._get_web_mapped_ptr(offset)
            memcpy(ptr, buf.view.buf, nbytes)
            return
        if nbytes == size:
            # A single copy
            status = wgpuBufferWriteMappedRange(
                <WGPUBuffer>_self_ptr(self), offset, buf.view.buf, size
            )
            _check()
            if status != WGPUStatus_Success:
                raise RuntimeError("Could not write mapped buffer.")
            return
        # Unaligned size: write into the (aligned) mapped range
        ptr = wgpuBufferGetMappedRange(<WGPUBuffer>_self_ptr(self), offset, size)
        _check()
        if ptr == NULL:
            raise RuntimeError("Could not get mapped range.")
        memcpy(ptr, buf.view.buf, nbytes)

    def _experimental_get_mapped_range(self, buffer_offset=None, size=None):
        """Undocumented and experimental. Returns a writable memoryview on the
        mapped memory. Using it after the buffer unmaps may segfault.
        """
        cdef void* ptr
        if self._map_state != enums.BufferMapState.mapped:
            raise RuntimeError("Can only write to a buffer if its mapped.")
        offset, size = self._check_range(buffer_offset, size)
        if _IS_EMSCRIPTEN:
            ptr = <void*><uintptr_t>self._get_web_mapped_ptr(offset)
        else:
            ptr = wgpuBufferGetMappedRange(<WGPUBuffer>_self_ptr(self), offset, size)
            _check()
            if ptr == NULL:
                raise RuntimeError("Could not get mapped range.")
        return PyMemoryView_FromMemory(<char*>ptr, size, PyBUF_WRITE)

    def destroy(self) -> None:
        self._release_memoryviews()
        if (<_Handle>self)._ptr != NULL:
            wgpuBufferDestroy(<WGPUBuffer>(<_Handle>self)._ptr)
            _check()

    def _release(self):
        self._release_memoryviews()
        super()._release()


class GPUTexture(classes.GPUTexture, GPUObjectBase):
    def _release_ptr(self, ptr):
        wgpuTextureRelease(<WGPUTexture><uintptr_t>ptr)

    def create_view(
        self,
        *,
        label: str = "",
        format=None,
        dimension=None,
        usage=0,
        aspect="all",
        base_mip_level: int = 0,
        mip_level_count=None,
        base_array_layer: int = 0,
        array_layer_count=None,
        swizzle: str = "rgba",
    ) -> GPUTextureView:
        cdef WGPUTextureViewDescriptor desc = WGPU_TEXTURE_VIEW_DESCRIPTOR_INIT
        cdef WGPUTextureView view
        if not format:
            format = self._tex_info["format"]
        if not dimension:
            dimension = self._tex_info["dimension"]
        elif not isinstance(dimension, str):
            raise TypeError(
                f"Texture view dimension must be a str, not {dimension.__class__.__name__}"
            )
        if not aspect:
            aspect = "all"
        if not mip_level_count:
            mip_level_count = self._tex_info["mip_level_count"] - base_mip_level
        if not array_layer_count:
            if dimension in ("1d", "2d", "3d"):
                array_layer_count = 1
            elif dimension == "cube":
                array_layer_count = 6
            elif dimension in ("2d-array", "cube-array"):
                array_layer_count = self._tex_info["size"][2] - base_array_layer
        if swizzle not in (None, "", "rgba"):
            raise NotImplementedError("Texture view swizzle is not yet supported by the Dawn backend.")
        if isinstance(usage, str):
            usage = str_flag_to_int(flags.TextureUsage, usage)

        label_b = _encode(label)
        desc.label = _sv(label_b)
        desc.format = <WGPUTextureFormat>_enum("TextureFormat", format)
        desc.dimension = <WGPUTextureViewDimension>_enum("TextureViewDimension", dimension)
        desc.aspect = <WGPUTextureAspect>_enum("TextureAspect", aspect)
        desc.baseMipLevel = base_mip_level
        desc.mipLevelCount = mip_level_count
        desc.baseArrayLayer = base_array_layer
        desc.arrayLayerCount = array_layer_count
        desc.usage = int(usage or 0)
        view = wgpuTextureCreateView(<WGPUTexture>_self_ptr(self), &desc)
        _check()
        return GPUTextureView(label, <uintptr_t>view, self._device, self, self.size)

    def destroy(self) -> None:
        if (<_Handle>self)._ptr != NULL:
            wgpuTextureDestroy(<WGPUTexture>(<_Handle>self)._ptr)
            _check()


