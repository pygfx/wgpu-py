class GPUQueue(classes.GPUQueue, GPUObjectBase):
    def _release_ptr(self, ptr):
        wgpuQueueRelease(<WGPUQueue><uintptr_t>ptr)

    def submit(self, command_buffers) -> None:
        cdef WGPUCommandBuffer stack[16]
        cdef WGPUCommandBuffer* c_buffers = stack
        cdef _Arena arena
        cdef size_t i
        cdef size_t n = len(command_buffers)
        cdef void* q = (<_Handle>self)._ptr
        if q == NULL:
            _raise_released(self)
        if n > 16:
            arena = _Arena()
            c_buffers = <WGPUCommandBuffer*>arena.alloc(n * sizeof(WGPUCommandBuffer))
        for i in range(n):
            c_buffers[i] = <WGPUCommandBuffer>_ptr(command_buffers[i])
        wgpuQueueSubmit(<WGPUQueue>q, n, c_buffers)
        _check()

    def write_buffer(self, buffer, buffer_offset, data, data_offset=0, size=None) -> None:
        cdef _Buffer buf = _Buffer(data)
        cdef Py_ssize_t nbytes = buf.view.len
        cdef uint64_t c_buffer_offset = buffer_offset
        cdef Py_ssize_t c_data_offset = data_offset
        cdef Py_ssize_t data_length
        cdef uint64_t buffer_size = buffer.size
        if not size:
            data_length = nbytes - c_data_offset
        else:
            data_length = size
        if not (c_buffer_offset < buffer_size):
            raise ValueError("Invalid buffer_offset")
        if not (0 <= c_data_offset < nbytes):
            raise ValueError("Invalid data_offset")
        if not (0 <= data_length <= (nbytes - c_data_offset)):
            raise ValueError("Invalid data_length")
        if not (<uint64_t>data_length <= buffer_size - c_buffer_offset):
            raise ValueError("Invalid data_length")
        # This call copies the data, so it's ok if the data is released afterwards.
        wgpuQueueWriteBuffer(
            <WGPUQueue>_self_ptr(self),
            <WGPUBuffer>_ptr(buffer),
            c_buffer_offset,
            <const char*>buf.view.buf + c_data_offset,
            data_length,
        )
        _check()

    def read_buffer(self, buffer, buffer_offset: int = 0, size: int | None = None):
        if not size:
            data_length = buffer.size - buffer_offset
        else:
            data_length = int(size)
        if not (0 <= buffer_offset < buffer.size):
            raise ValueError("Invalid buffer_offset")
        if not (data_length <= buffer.size - buffer_offset):
            raise ValueError("Invalid data_length")

        device = buffer._device
        tmp_usage = flags.BufferUsage.COPY_DST | flags.BufferUsage.MAP_READ
        tmp_buffer = device._create_buffer("", data_length, tmp_usage, False)

        encoder = device.create_command_encoder()
        encoder.copy_buffer_to_buffer(buffer, buffer_offset, tmp_buffer, 0, data_length)
        self.submit([encoder.finish()])

        tmp_buffer.map_async("READ").sync_wait()
        data = tmp_buffer.read_mapped()
        tmp_buffer.destroy()
        return data

    def write_texture(self, destination, data, data_layout, size) -> None:
        cdef WGPUTexelCopyTextureInfo c_destination
        cdef WGPUTexelCopyBufferLayout c_layout = WGPU_TEXEL_COPY_BUFFER_LAYOUT_INIT
        cdef WGPUExtent3D c_size
        cdef _Buffer buf
        check_struct("TexelCopyTextureInfo", destination)
        check_struct("TexelCopyBufferLayout", data_layout)
        _fill_texel_copy_texture_info(&c_destination, destination)
        buf = _Buffer(data)
        size = _tuple_from_extent3d(size)
        _fill_extent(&c_size, size)
        c_layout.offset = data_layout.get("offset", 0)
        c_layout.bytesPerRow = data_layout["bytes_per_row"]
        c_layout.rowsPerImage = data_layout.get("rows_per_image", size[1])
        wgpuQueueWriteTexture(
            <WGPUQueue>_self_ptr(self),
            &c_destination,
            buf.view.buf,
            buf.view.len,
            &c_layout,
            &c_size,
        )
        _check()

    _shared_copy_buffer = None, 0

    def read_texture(self, source, data_layout, size):
        device = source["texture"]._device

        ori_offset = data_layout.get("offset", 0)
        ori_stride = data_layout["bytes_per_row"]
        extra_stride = (256 - ori_stride % 256) % 256
        full_stride = ori_stride + extra_stride

        size = _tuple_from_extent3d(size)
        data_length = full_stride * size[1] * size[2]

        is_present_texture = source["texture"].label == "present"
        copy_buffer = None
        if is_present_texture:
            copy_buffer, time_since_size_ok = self._shared_copy_buffer
            if copy_buffer is None:
                pass
            elif copy_buffer.size < data_length:
                copy_buffer = None
            elif copy_buffer.size < data_length * 4:
                self._shared_copy_buffer = copy_buffer, time.time()
            elif time.time() - time_since_size_ok > 5.0:
                copy_buffer = None
        if copy_buffer is None:
            buffer_size = data_length
            buffer_size += (4096 - buffer_size % 4096) % 4096
            buf_usage = flags.BufferUsage.COPY_DST | flags.BufferUsage.MAP_READ
            copy_buffer = device._create_buffer("copy-buffer", buffer_size, buf_usage, False)
            if is_present_texture:
                self._shared_copy_buffer = copy_buffer, time.time()

        destination = {
            "buffer": copy_buffer,
            "offset": 0,
            "bytes_per_row": full_stride,
            "rows_per_image": data_layout.get("rows_per_image", size[1]),
        }

        encoder = device.create_command_encoder()
        encoder.copy_texture_to_buffer(source, destination, size)
        self.submit([encoder.finish()])

        promise = copy_buffer.map_async("READ", 0, data_length)
        if copy_buffer.map_state == "pending":
            promise.sync_wait()
        mapped_data = copy_buffer.read_mapped(copy=False)

        data_length2 = ori_stride * size[1] * size[2] + ori_offset
        if extra_stride or ori_offset:
            data = memoryview(bytearray(data_length2)).cast(mapped_data.format)
            i_start = ori_offset
            for i in range(size[1] * size[2]):
                row = mapped_data[i * full_stride : i * full_stride + ori_stride]
                data[i_start : i_start + ori_stride] = row
                i_start += ori_stride
        else:
            data = memoryview(bytearray(mapped_data)).cast(mapped_data.format)

        copy_buffer.unmap()
        return data

    def on_submitted_work_done_async(self) -> GPUPromise[None]:
        cdef WGPUQueueWorkDoneCallbackInfo cb = WGPU_QUEUE_WORK_DONE_CALLBACK_INFO_INIT
        cdef WGPUFuture future
        promise = GPUPromise("on_submitted_work_done", None)
        cb.mode = _CALLBACK_MODE
        cb.callback = _queue_work_done_callback
        cb.userdata1 = _promise_userdata(promise)
        future = wgpuQueueOnSubmittedWorkDone(<WGPUQueue>_self_ptr(self), cb)
        _check()
        promise._set_future(future.id)
        return promise


