cdef dict _get_limits(void* ptr, bint is_device):
    cdef WGPULimits c_limits = WGPU_LIMITS_INIT
    cdef WGPUStatus status
    if is_device:
        status = wgpuDeviceGetLimits(<WGPUDevice>ptr, &c_limits)
    else:
        status = wgpuAdapterGetLimits(<WGPUAdapter>ptr, &c_limits)
    _check()
    if status != WGPUStatus_Success:
        raise RuntimeError("Error getting limits")
    return dict(sorted(limits_to_dict(&c_limits).items()))


cdef set _get_features(void* ptr, bint is_device):
    cdef WGPUSupportedFeatures c_features
    cdef size_t i
    memset(&c_features, 0, sizeof(c_features))
    if is_device:
        wgpuDeviceGetFeatures(<WGPUDevice>ptr, &c_features)
    else:
        wgpuAdapterGetFeatures(<WGPUAdapter>ptr, &c_features)
    _check()
    int2str = enum_int2str["FeatureName"]
    features = set()
    for i in range(c_features.featureCount):
        name = int2str.get(<int>c_features.features[i], None)
        if name is not None:
            features.add(name)
    wgpuSupportedFeaturesFreeMembers(c_features)
    return features


def _feature_name_to_int(f):
    if not isinstance(f, str):
        raise TypeError("Features must be given as str.")
    f = f.replace("_", "-")
    if f.lower() != f:
        f = to_snake_case(f, "-")
    i = enummap.get(f"FeatureName.{f}", None)
    if i is None:
        i = enum_str2int["FeatureName"].get(f, None)
    if i is None:
        raise KeyError(f"Unknown feature: '{f}'")
    return i


# %% The API


cdef WGPUBackendType _get_forced_backend() except? WGPUBackendType_Undefined:
    force_backend = os.getenv("WGPU_BACKEND_TYPE", "").strip()
    if not force_backend:
        return WGPUBackendType_Undefined
    backends = enum_str2int["BackendType"]
    # Be case-insensitive
    lower_map = {k.lower(): v for k, v in backends.items()}
    value = lower_map.get(force_backend.lower(), None)
    if value is None:
        logger.warning(
            f"Invalid value for WGPU_BACKEND_TYPE: '{force_backend}'.\nValid values are: {list(backends.keys())}"
        )
        return WGPUBackendType_Undefined
    logger.warning(f"Forcing backend: {force_backend} ({value})")
    return <WGPUBackendType><int>value


class GPU(classes.GPU):
    def request_adapter_async(
        self,
        *,
        feature_level: str = "core",
        power_preference: enums.PowerPreferenceEnum | None = None,
        force_fallback_adapter: bool = False,
        canvas=None,
    ) -> GPUPromise[GPUAdapter]:
        """Create a `GPUAdapter`, the object that represents an abstract wgpu
        implementation, from which one can request a `GPUDevice`.

        This is the implementation based on Dawn.

        Arguments:
            feature_level (str): "core" or "compatibility".
            power_preference (PowerPreference): "high-performance" or "low-power".
            force_fallback_adapter (bool): whether to use a (probably CPU-based)
                fallback adapter.
            canvas : The canvas or context that the adapter should be able to render to. This can typically
                be left to None. If given, it must be a ``GPUCanvasContext`` or ``RenderCanvas``.
        """
        adapter_name = os.getenv("WGPUPY_WGPU_ADAPTER_NAME")
        if adapter_name and not _IS_EMSCRIPTEN:
            adapters = self._enumerate_adapters()
            adapters = [a for a in adapters if adapter_name in a.summary]
            if not adapters:
                raise ValueError(f"Adapter with name '{adapter_name}' not found.")
            promise = GPUPromise("adapter by name", None)
            promise._wgpu_set_input(adapters[0])
            return promise

        cdef WGPUBackendType backend = _get_forced_backend()
        return self._request_adapter(
            feature_level, power_preference, force_fallback_adapter, canvas, <int>backend
        )

    def _request_adapter(
        self, feature_level, power_preference, force_fallback_adapter, canvas, int backend
    ):
        cdef WGPURequestAdapterOptions opts = WGPU_REQUEST_ADAPTER_OPTIONS_INIT
        cdef WGPURequestAdapterCallbackInfo cb = WGPU_REQUEST_ADAPTER_CALLBACK_INFO_INIT
        cdef WGPUFuture future
        cdef WGPUInstance instance = _get_instance()

        if feature_level == "compatibility":
            opts.featureLevel = WGPUFeatureLevel_Compatibility
        elif feature_level in ("core", None):
            opts.featureLevel = WGPUFeatureLevel_Core
        else:
            raise ValueError(f"Invalid feature_level: {feature_level!r}")
        opts.powerPreference = <WGPUPowerPreference>_enum(
            "PowerPreference", power_preference or "high-performance"
        )
        opts.forceFallbackAdapter = bool(force_fallback_adapter)
        opts.backendType = <WGPUBackendType>backend

        if canvas is not None:
            surface_id = find_surface_id_from_canvas(canvas)
            if surface_id:
                opts.compatibleSurface = <WGPUSurface><uintptr_t>surface_id

        promise = GPUPromise("request_adapter", self._create_adapter)
        cb.mode = _CALLBACK_MODE
        cb.callback = _request_adapter_callback
        cb.userdata1 = _promise_userdata(promise)
        future = wgpuInstanceRequestAdapter(instance, &opts, cb)
        _check()
        promise._set_future(future.id)
        if not _IS_EMSCRIPTEN:
            # Dawn resolves this (almost) immediately. Make it effectively sync,
            # like the wgpu-native backend, so that sync and async code paths match.
            # In the browser it resolves via the JS event loop.
            _wait_future(future.id)
        return promise

    def enumerate_adapters_async(self) -> GPUPromise[list[GPUAdapter]]:
        """Get a list of adapter objects available on the current system.
        This is the implementation based on Dawn.

        Natively, this lists all adapters that Dawn finds, e.g. GPUs as well as
        CPU adapters like lavapipe. Since webgpu.h cannot enumerate adapters,
        this uses Dawn's C++ API (see dawn_native_extras.cpp). In the browser,
        it returns the one adapter that the browser provides.
        """
        if _IS_EMSCRIPTEN:
            return self.request_adapter_async().then(
                lambda adapter: [adapter], title="enumerate_adapters"
            )
        result = self._enumerate_adapters()
        promise = GPUPromise("enumerate_adapters", None)
        promise._wgpu_set_input(result)
        return promise

    def _enumerate_adapters(self):
        cdef WGPUAdapter* c_adapters
        cdef size_t i, n
        cdef WGPUInstance instance = _get_instance()
        if not _IS_EMSCRIPTEN:
            # Use Dawn's C++ API to list all adapters (see dawn_native_extras.cpp)
            n = wgpupy_dawn_enumerate_adapters(instance, NULL, NULL, 0)
            if n != <size_t>-1:
                c_adapters = <WGPUAdapter*>PyMem_Calloc(max(n, 1), sizeof(WGPUAdapter))
                try:
                    n = min(n, wgpupy_dawn_enumerate_adapters(instance, NULL, c_adapters, n))
                    _check()
                    ids = [<uintptr_t>c_adapters[i] for i in range(n)]
                finally:
                    PyMem_Free(c_adapters)
                adapters = [self._create_adapter(adapter_id) for adapter_id in ids]
                # Dawn's Null backend is for testing only
                return [a for a in adapters if a.info["backend_type"] != "Null"]
        return self._enumerate_adapters_by_requesting()

    def _enumerate_adapters_by_requesting(self):
        # Request an adapter for each combination of options, and de-duplicate.
        # Dawn only returns a CPU adapter (e.g. lavapipe) if a fallback adapter
        # is requested (or if it is the only one), and only exposes its OpenGL
        # backends at the compatibility feature level.
        adapters = []
        seen = set()
        backend_names = [
            "Vulkan",
            "Metal",
            "D3D12",
            "D3D11",
            "OpenGL",
            "OpenGLES",
        ]
        for name in backend_names:
            backend = enum_str2int["BackendType"].get(name)
            if backend is None:
                continue
            feature_level = "compatibility" if name.startswith("OpenGL") else "core"
            for fallback in (False, True):
                for pref in ("high-performance", "low-power"):
                    try:
                        promise = self._request_adapter(
                            feature_level, pref, fallback, None, backend
                        )
                        adapter = promise.sync_wait()
                    except Exception:
                        continue
                    info = adapter.info
                    key = (
                        info["vendor_id"],
                        info["device_id"],
                        info["device"],
                        info["backend_type"],
                    )
                    if key not in seen:
                        seen.add(key)
                        adapters.append(adapter)
        return adapters

    def _create_adapter(self, adapter_id):
        cdef WGPUAdapter adapter = <WGPUAdapter><uintptr_t>adapter_id
        cdef WGPUAdapterInfo c_info = WGPU_ADAPTER_INFO_INIT
        cdef WGPUStatus status = wgpuAdapterGetInfo(adapter, &c_info)
        _check()
        if status != WGPUStatus_Success:
            raise RuntimeError("Error calling wgpuAdapterGetInfo")

        adapter_info_data = {
            # Spec
            "vendor": _from_sv(c_info.vendor),
            "architecture": _from_sv(c_info.architecture),
            "device": _from_sv(c_info.device),
            "description": _from_sv(c_info.description),
            "subgroup_min_size": c_info.subgroupMinSize,
            "subgroup_max_size": c_info.subgroupMaxSize,
            # Extra
            "vendor_id": c_info.vendorID,
            "device_id": c_info.deviceID,
            "adapter_type": enum_int2str["AdapterType"].get(
                <int>c_info.adapterType, "unknown"
            ),
            "backend_type": enum_int2str["BackendType"].get(
                <int>c_info.backendType, "unknown"
            ),
        }
        wgpuAdapterInfoFreeMembers(c_info)
        _align_adapter_info(adapter_info_data)
        adapter_info = GPUAdapterInfo(adapter_info_data)

        limits = _get_limits(adapter, False)
        features = _get_features(adapter, False)
        return GPUAdapter(adapter_id, features, limits, adapter_info)

    def get_canvas_context(self, present_info: dict) -> GPUCanvasContext:
        """Get the GPUCanvasContext object for the appropriate backend.

        Note that the recommended way to get a context is to instead use the ``rendercanvas`` library.
        """
        return GPUCanvasContext(present_info)

    @property
    def wgsl_language_features(self):
        """A set of strings representing the WGSL language extensions supported by all adapters."""
        cdef WGPUSupportedWGSLLanguageFeatures c_features
        cdef size_t i
        memset(&c_features, 0, sizeof(c_features))
        wgpuInstanceGetWGSLLanguageFeatures(_get_instance(), &c_features)
        names = set()
        for i in range(c_features.featureCount):
            names.add(<int>c_features.features[i])
        wgpuSupportedWGSLLanguageFeaturesFreeMembers(c_features)
        return names


def _align_adapter_info(d):
    """Make the adapter info match that of the wgpu-native backend where Dawn differs.

    Dawn reports a normalized vendor name (e.g. "intel", or "mesa" for
    lavapipe), and for Vulkan the description is "<driver name>: <driver info>".
    wgpu-native reports the driver name as the vendor (e.g. "llvmpipe") and the
    driver info as the description. Code that identifies adapters (e.g. checks
    for lavapipe with ``info["vendor"] == "llvmpipe"``) relies on the latter, so
    we follow wgpu-native, and keep Dawn's vendor name as "vendor_name".
    """
    d["vendor_name"] = d["vendor"]
    if d["backend_type"] == "Vulkan" and ": " in d["description"]:
        driver_name, driver_info = d["description"].split(": ", 1)
        d["vendor"] = driver_name
        d["description"] = driver_info


# Instantiate API entrypoint
gpu = GPU()


def find_surface_id_from_canvas(canvas_or_context):
    """Try to get the surface_id from a RenderCanvas, rendercanvas context, or GPUCanvasContect."""
    ob = canvas_or_context
    surface_id = None
    if hasattr(ob, "get_context"):
        ob = ob.get_context("wgpu")
    for attr in ["_wgpu_context"]:
        if hasattr(ob, attr):
            ob = getattr(ob, attr)
    if hasattr(ob, "_surface_id"):
        surface_id = ob._surface_id
    return surface_id


_canvas_count = 0


def get_surface_id_from_info(present_info):
    """Get an id (address) representing the surface to render to. The way to
    obtain this id differs per platform and GUI toolkit.
    """
    cdef WGPUSurfaceDescriptor desc = WGPU_SURFACE_DESCRIPTOR_INIT
    cdef WGPUSurfaceSourceXlibWindow xlib = WGPU_SURFACE_SOURCE_XLIB_WINDOW_INIT
    cdef WGPUSurfaceSourceWaylandSurface wayland = WGPU_SURFACE_SOURCE_WAYLAND_SURFACE_INIT
    cdef WGPUSurfaceSourceXCBWindow xcb = WGPU_SURFACE_SOURCE_XCB_WINDOW_INIT
    cdef WGPUSurfaceSourceWindowsHWND hwnd = WGPU_SURFACE_SOURCE_WINDOWS_HWND_INIT
    cdef WGPUSurfaceSourceMetalLayer metal = WGPU_SURFACE_SOURCE_METAL_LAYER_INIT
    cdef WGPUEmscriptenSurfaceSourceCanvasHTMLSelector html_canvas = WGPU_EMSCRIPTEN_SURFACE_SOURCE_CANVAS_HTML_SELECTOR_INIT
    cdef WGPUSurface surface

    if _IS_EMSCRIPTEN:
        # Emdawnwebgpu identifies the <canvas> element by a CSS selector
        global _canvas_count
        canvas = present_info["window"]
        if not canvas.id:
            _canvas_count += 1
            canvas.id = f"wgpu-dawn-canvas-{_canvas_count}"
        selector = f"#{canvas.id}".encode()
        html_canvas.selector = _sv(selector)
        desc.nextInChain = <WGPUChainedStruct*>&html_canvas
    elif sys.platform.startswith("win"):  # no-cover
        import ctypes

        hwnd.hinstance = <void*><uintptr_t>ctypes.windll.kernel32.GetModuleHandleW(None)
        hwnd.hwnd = <void*><uintptr_t>int(present_info["window"])
        desc.nextInChain = <WGPUChainedStruct*>&hwnd
    elif sys.platform.startswith("darwin"):  # no-cover
        metal_layer = _get_metal_layer(present_info)
        metal.layer = <void*><uintptr_t>metal_layer
        desc.nextInChain = <WGPUChainedStruct*>&metal
    elif sys.platform.startswith("linux"):  # no-cover
        platform = present_info.get("platform", "x11")
        if platform == "x11":
            xlib.display = <void*><uintptr_t>present_info["display"]
            xlib.window = int(present_info["window"])
            desc.nextInChain = <WGPUChainedStruct*>&xlib
        elif platform == "wayland":
            wayland.display = <void*><uintptr_t>present_info["display"]
            wayland.surface = <void*><uintptr_t>present_info["window"]
            desc.nextInChain = <WGPUChainedStruct*>&wayland
        elif platform == "xcb":
            xcb.connection = <void*><uintptr_t>present_info["connection"]
            xcb.window = int(present_info["window"])
            desc.nextInChain = <WGPUChainedStruct*>&xcb
        else:
            raise RuntimeError(f"Unexpected Linux surface platform '{platform}'.")
    else:  # no-cover
        raise RuntimeError("Cannot get surface id: unsupported platform.")

    surface = wgpuInstanceCreateSurface(_get_instance(), &desc)
    _check()
    if surface == NULL:
        raise RuntimeError("Could not create surface.")
    return <uintptr_t>surface


def _get_metal_layer(present_info):  # no-cover
    import ctypes
    from rubicon.objc.api import ObjCInstance, ObjCClass

    window = ctypes.c_void_p(present_info["window"])
    cw = ObjCInstance(window)
    try:
        cv = cw.contentView
    except AttributeError:
        wx_view = ObjCInstance(window)
        if not len(wx_view.subviews):
            new_view = ObjCClass("NSView").alloc().initWithFrame(wx_view.bounds)
            new_view.setAutoresizingMask(18)
            wx_view.setAutoresizesSubviews(True)
            wx_view.addSubview(new_view)
        cv = wx_view.subviews[0]
    if cv.layer and cv.layer.isKindOfClass(ObjCClass("CAMetalLayer")):
        metal_layer = cv.layer
    else:
        metal_layer = ObjCClass("CAMetalLayer").layer()
        cv.setLayer(metal_layer)
        cv.setWantsLayer(True)
    return metal_layer.ptr.value


class GPUCanvasContext(classes.GPUCanvasContext):
    # The context must first be configured. Then a texture can be obtained,
    # which can be written to, and then it can be presented.

    _surface_id = None
    _wgpu_config = None

    def __init__(self, present_info: dict):
        super().__init__(present_info)
        self._surface_id = get_surface_id_from_info(present_info)
        self._number_of_successive_unsuccesful_textures = 0

    def _get_capabilities_screen(self, adapter):
        cdef WGPUSurfaceCapabilities c_caps = WGPU_SURFACE_CAPABILITIES_INIT
        cdef WGPUStatus status
        cdef size_t i
        surface_id = self._surface_id
        assert surface_id
        status = wgpuSurfaceGetCapabilities(
            <WGPUSurface><uintptr_t>surface_id, <WGPUAdapter>_ptr(adapter), &c_caps
        )
        _check()
        if status != WGPUStatus_Success:
            raise RuntimeError("Error calling wgpuSurfaceGetCapabilities")

        capabilities = {"usages": c_caps.usages}
        if not c_caps.usages and _IS_EMSCRIPTEN:
            # Emdawnwebgpu does not report usages; a canvas supports these
            capabilities["usages"] = (
                flags.TextureUsage.RENDER_ATTACHMENT
                | flags.TextureUsage.COPY_SRC
                | flags.TextureUsage.COPY_DST
                | flags.TextureUsage.TEXTURE_BINDING
            )
        formats = []
        for i in range(c_caps.formatCount):
            str_val = enum_int2str["TextureFormat"].get(<int>c_caps.formats[i])
            if str_val:
                formats.append(str_val)
        capabilities["formats"] = formats or [
            enums.TextureFormat.bgra8unorm_srgb,
            enums.TextureFormat.bgra8unorm,
        ]
        alpha_modes = []
        for i in range(c_caps.alphaModeCount):
            str_val = enum_int2str["CompositeAlphaMode"].get(<int>c_caps.alphaModes[i])
            if str_val:
                alpha_modes.append(str_val.lower())
        capabilities["alpha_modes"] = alpha_modes or [enums.CanvasAlphaMode.opaque]
        present_modes = []
        for i in range(c_caps.presentModeCount):
            str_val = enum_int2str["PresentMode"].get(<int>c_caps.presentModes[i])
            if str_val:
                present_modes.append(str_val.lower())
        capabilities["present_modes"] = present_modes or ["fifo"]
        wgpuSurfaceCapabilitiesFreeMembers(c_caps)
        return capabilities

    def _configure_screen(
        self,
        *,
        device,
        format,
        usage,
        view_formats,
        color_space,
        tone_mapping,
        alpha_mode,
    ):
        capabilities = self._get_capabilities(device.adapter)
        check_struct("CanvasToneMapping", tone_mapping)

        if self._present_info.get("vsync", True):
            present_mode_pref = ["fifo", "mailbox"]
        else:
            present_mode_pref = ["immediate", "mailbox", "fifo"]
        present_modes = [
            p for p in present_mode_pref if p in capabilities["present_modes"]
        ]
        present_mode = (present_modes or capabilities["present_modes"])[0]

        alpha_mode_map = {
            "auto": WGPUCompositeAlphaMode_Auto,
            "opaque": WGPUCompositeAlphaMode_Opaque,
            "premultiplied": WGPUCompositeAlphaMode_Premultiplied,
            "unpremultiplied": WGPUCompositeAlphaMode_Unpremultiplied,
            "inherit": WGPUCompositeAlphaMode_Inherit,
        }
        present_mode_map = {
            "fifo": WGPUPresentMode_Fifo,
            "fiforelaxed": WGPUPresentMode_FifoRelaxed,
            "immediate": WGPUPresentMode_Immediate,
            "mailbox": WGPUPresentMode_Mailbox,
        }
        self._wgpu_config = {
            "device": device,
            "format": _enum("TextureFormat", format),
            "usage": int(usage),
            "view_formats": [_enum("TextureFormat", f) for f in view_formats],
            "alpha_mode": alpha_mode_map[alpha_mode],
            "present_mode": present_mode_map[present_mode],
            "width": self._physical_size[0],
            "height": self._physical_size[1],
        }
        self._configure_screen_real()

    def _configure_screen_real(self):
        cdef WGPUSurfaceConfiguration config = WGPU_SURFACE_CONFIGURATION_INIT
        cdef _Arena arena = _Arena()
        cdef WGPUTextureFormat* view_formats
        cdef size_t i
        self._drop_texture()
        c = self._wgpu_config
        if self._surface_id and c["width"] > 0 and c["height"] > 0:
            config.device = <WGPUDevice>_ptr(c["device"])
            config.format = <WGPUTextureFormat><int>c["format"]
            config.usage = c["usage"]
            config.width = c["width"]
            config.height = c["height"]
            config.alphaMode = <WGPUCompositeAlphaMode><int>c["alpha_mode"]
            config.presentMode = <WGPUPresentMode><int>c["present_mode"]
            n = len(c["view_formats"])
            view_formats = <WGPUTextureFormat*>arena.alloc(n * sizeof(WGPUTextureFormat))
            for i in range(n):
                view_formats[i] = <WGPUTextureFormat><int>c["view_formats"][i]
            config.viewFormatCount = n
            config.viewFormats = view_formats
            wgpuSurfaceConfigure(<WGPUSurface><uintptr_t>self._surface_id, &config)
            _check()
        else:
            c["width"] = 0

    def _unconfigure_screen(self):
        if self._surface_id:
            wgpuSurfaceUnconfigure(<WGPUSurface><uintptr_t>self._surface_id)
            _check()
            self._wgpu_config = None

    def _create_texture_screen(self):
        cdef WGPUSurfaceTexture surface_texture = WGPU_SURFACE_TEXTURE_INIT
        cdef WGPUSurface surface
        cdef WGPUTexture texture
        if self._surface_id is None:
            raise RuntimeError("Looks like the CanvasContext is already destroyed.")
        if self._wgpu_config is None:
            raise RuntimeError(
                "Cannot get surface texture because the CanvasContext has not yet been configured."
            )
        surface = <WGPUSurface><uintptr_t>self._surface_id

        if self._has_new_size:
            self._has_new_size = False
            new_size = self._physical_size
            old_size = (self._wgpu_config["width"], self._wgpu_config["height"])
            if new_size[0] <= 0 or new_size[1] <= 0:
                raise RuntimeError("Cannot get texture for a canvas with zero pixels.")
            if new_size != old_size:
                self._wgpu_config["width"] = new_size[0]
                self._wgpu_config["height"] = new_size[1]
                self._configure_screen_real()

        wgpuSurfaceGetCurrentTexture(surface, &surface_texture)
        _check()
        status = surface_texture.status

        if status == WGPUSurfaceGetCurrentTextureStatus_SuccessOptimal:
            self._number_of_successive_unsuccesful_textures = 0
        elif status in (
            WGPUSurfaceGetCurrentTextureStatus_SuccessSuboptimal,
            WGPUSurfaceGetCurrentTextureStatus_Outdated,
            WGPUSurfaceGetCurrentTextureStatus_Lost,
        ):
            if surface_texture.texture != NULL:
                wgpuTextureRelease(surface_texture.texture)
                surface_texture.texture = NULL
            self._configure_screen_real()
            wgpuSurfaceGetCurrentTexture(surface, &surface_texture)
            _check()
            status = surface_texture.status

        if status != WGPUSurfaceGetCurrentTextureStatus_SuccessOptimal:
            status_str = enum_int2str["SurfaceGetCurrentTextureStatus"].get(
                <int>status, "Unknown"
            )
            self._number_of_successive_unsuccesful_textures += 1
            n = self._number_of_successive_unsuccesful_textures
            if (n % 100 == 0) or n in (5, 12, 25, 50):
                logger.warning(
                    f"No succesful surface texture obtained for {n} frames: {status_str!r}"
                )
            if status != WGPUSurfaceGetCurrentTextureStatus_SuccessSuboptimal:
                if surface_texture.texture != NULL:
                    wgpuTextureRelease(surface_texture.texture)
                raise classes.DrawCancelled(f"{status_str} ({<int>status})")

        texture = surface_texture.texture
        if texture == NULL:
            raise RuntimeError("Cannot get surface texture (no texture)")

        tex_info = {
            "size": (
                wgpuTextureGetWidth(texture),
                wgpuTextureGetHeight(texture),
                wgpuTextureGetDepthOrArrayLayers(texture),
            ),
            "mip_level_count": wgpuTextureGetMipLevelCount(texture),
            "sample_count": wgpuTextureGetSampleCount(texture),
            "dimension": enum_int2str["TextureDimension"][<int>wgpuTextureGetDimension(texture)],
            "format": enum_int2str["TextureFormat"][<int>wgpuTextureGetFormat(texture)],
            "usage": wgpuTextureGetUsage(texture),
        }
        device = self._config["device"]
        return GPUTexture("", <uintptr_t>texture, device, tex_info)

    def _present_screen(self):
        cdef WGPUStatus status
        if _IS_EMSCRIPTEN:
            # The browser presents the canvas when control returns to the event loop
            _log_pending_errors()
            return
        status = wgpuSurfacePresent(<WGPUSurface><uintptr_t>self._surface_id)
        _log_pending_errors()
        if status != WGPUStatus_Success:
            logger.warning("wgpuSurfacePresent failed")

    def _release(self):
        self._drop_texture()
        if self._surface_id is not None:
            self._surface_id, surface_id = None, self._surface_id
            if surface_id:
                wgpuSurfaceRelease(<WGPUSurface><uintptr_t>surface_id)


class GPUObjectBase(classes.GPUObjectBase, _Handle):
    _handle_kind = _KIND_OTHER

    def __init__(self, label, internal, device, *args):
        super().__init__(label, internal, device, *args)
        (<_Handle>self)._kind = self._handle_kind

    def _release(self):
        cdef void* p = (<_Handle>self)._ptr
        if p != NULL:
            (<_Handle>self)._ptr = NULL
            self._release_ptr(<uintptr_t>p)
            _log_pending_errors()

    def _release_ptr(self, ptr):
        raise NotImplementedError()


class GPUAdapterInfo(classes.GPUAdapterInfo):
    pass


class GPUAdapter(classes.GPUAdapter, _Handle):
    def request_device_async(
        self,
        *,
        label: str = "",
        required_features=(),
        required_limits=None,
        default_queue=None,
    ) -> GPUPromise[GPUDevice]:
        required_limits = {} if required_limits is None else required_limits
        if default_queue:
            check_struct("QueueDescriptor", default_queue)
        return self._request_device_async(
            label, required_features, required_limits, default_queue
        )

    def _request_device_async(self, label, required_features, required_limits, default_queue):
        cdef WGPUDeviceDescriptor desc = WGPU_DEVICE_DESCRIPTOR_INIT
        cdef WGPULimits c_limits = WGPU_LIMITS_INIT
        cdef WGPURequestDeviceCallbackInfo cb = WGPU_REQUEST_DEVICE_CALLBACK_INFO_INIT
        cdef WGPUFeatureName* c_features
        cdef _Arena arena = _Arena()
        cdef WGPUFuture future
        cdef size_t i

        # ---- Features
        assert isinstance(required_features, (tuple, list, set))
        feature_ints = sorted({_feature_name_to_int(f) for f in required_features})
        c_features = <WGPUFeatureName*>arena.alloc(
            len(feature_ints) * sizeof(WGPUFeatureName)
        )
        for i in range(len(feature_ints)):
            c_features[i] = <WGPUFeatureName><int>feature_ints[i]

        # ---- Limits: like the wgpu-native backend, default to the adapter's limits
        def canonicalize_limit_name(name):
            if name in self._limits:
                return name
            if "_" in name:
                alt_name = name.replace("_", "-")
                if alt_name in self._limits:
                    return alt_name
            alt_name = to_snake_case(name, "-")
            if alt_name in self._limits:
                return alt_name
            raise KeyError(f"Unknown limit name '{name}'")

        limits = dict(self._limits)
        if required_limits:
            assert isinstance(required_limits, dict)
            for key, value in required_limits.items():
                key = canonicalize_limit_name(key)
                if value is not None:
                    limits[key] = value
        dict_to_limits(limits, &c_limits)

        # ---- Descriptor
        desc.label = arena.sv(label)
        desc.requiredFeatureCount = len(feature_ints)
        desc.requiredFeatures = c_features
        desc.requiredLimits = &c_limits
        desc.defaultQueue.label = arena.sv("default_queue")
        lost_promise = GPUPromise("device.lost", None)
        desc.deviceLostCallbackInfo.mode = WGPUCallbackMode_AllowSpontaneous
        desc.deviceLostCallbackInfo.callback = _device_lost_callback
        desc.deviceLostCallbackInfo.userdata1 = _promise_userdata(lost_promise)
        desc.uncapturedErrorCallbackInfo.callback = _uncaptured_error_callback

        def handler(device_id):
            device = self._create_device(label, device_id)
            device._lost_promise = lost_promise
            return device

        promise = GPUPromise("request_device", handler)
        cb.mode = _CALLBACK_MODE
        cb.callback = _request_device_callback
        cb.userdata1 = _promise_userdata(promise)
        future = wgpuAdapterRequestDevice(<WGPUAdapter>_self_ptr(self), &desc, cb)
        _check()
        promise._set_future(future.id)
        if not _IS_EMSCRIPTEN:
            _wait_future(future.id)  # see _request_adapter()
        return promise

    def _create_device(self, label, device_id):
        cdef WGPUDevice device = <WGPUDevice><uintptr_t>device_id
        cdef WGPULoggingCallbackInfo log_cb = WGPU_LOGGING_CALLBACK_INFO_INIT
        if not _IS_EMSCRIPTEN:  # The browser logs to the JS console
            log_cb.callback = _logging_callback
            wgpuDeviceSetLoggingCallback(device, log_cb)
        limits = _get_limits(device, True)
        features = _get_features(device, True)
        queue_id = <uintptr_t>wgpuDeviceGetQueue(device)
        queue = GPUQueue("", queue_id, None)
        return GPUDevice(label, device_id, self, features, limits, queue)

    def _release(self):
        cdef void* p = (<_Handle>self)._ptr
        if p != NULL:
            (<_Handle>self)._ptr = NULL
            wgpuAdapterRelease(<WGPUAdapter>p)


class GPUDevice(classes.GPUDevice, GPUObjectBase):
    def _release_ptr(self, ptr):
        wgpuDeviceRelease(<WGPUDevice><uintptr_t>ptr)

    def _poll(self, block=False):
        # Internal function, for compatibility with the wgpu-native backend
        if (<_Handle>self)._ptr != NULL:
            if not _IS_EMSCRIPTEN:  # in the browser, the event loop does this
                wgpuDeviceTick(<WGPUDevice>(<_Handle>self)._ptr)
                process_events()
            if block:
                self.queue.on_submitted_work_done_sync()

    def _poll_wait(self):
        self._poll(True)

    def _get_lost_async(self) -> GPUPromise[GPUDeviceLostInfo]:
        return self._lost_promise

    def create_buffer(
        self,
        *,
        label: str = "",
        size: int,
        usage: flags.BufferUsageFlags,
        mapped_at_creation: bool = False,
    ) -> GPUBuffer:
        return self._create_buffer(label, int(size), usage, bool(mapped_at_creation))

    def _create_buffer(self, label, uint64_t size, usage, bint mapped_at_creation):
        cdef WGPUBufferDescriptor desc = WGPU_BUFFER_DESCRIPTOR_INIT
        cdef WGPUBuffer buffer
        if isinstance(usage, str):
            usage = str_flag_to_int(flags.BufferUsage, usage)
        label_b = _encode(label)
        desc.label = _sv(label_b)
        desc.size = size
        desc.usage = int(usage)
        desc.mappedAtCreation = mapped_at_creation
        buffer = wgpuDeviceCreateBuffer(<WGPUDevice>_self_ptr(self), &desc)
        _check()
        map_state = (
            enums.BufferMapState.mapped
            if mapped_at_creation
            else enums.BufferMapState.unmapped
        )
        return GPUBuffer(label, <uintptr_t>buffer, self, size, int(usage), map_state)

    def create_texture(
        self,
        *,
        label: str = "",
        size,
        mip_level_count: int = 1,
        sample_count: int = 1,
        dimension: enums.TextureDimensionEnum = "2d",
        format: enums.TextureFormatEnum,
        usage: flags.TextureUsageFlags,
        view_formats=(),
        texture_binding_view_dimension=None,
    ) -> GPUTexture:
        cdef WGPUTextureDescriptor desc = WGPU_TEXTURE_DESCRIPTOR_INIT
        cdef WGPUTextureBindingViewDimension view_dim_desc = WGPU_TEXTURE_BINDING_VIEW_DIMENSION_INIT
        cdef _Arena arena = _Arena()
        cdef WGPUTextureFormat* c_view_formats
        cdef WGPUTexture texture
        cdef size_t i

        if isinstance(usage, str):
            usage = str_flag_to_int(flags.TextureUsage, usage)
        usage = int(usage)
        size = _tuple_from_extent3d(size)
        if not isinstance(dimension, str):
            raise TypeError(
                f"Texture dimension must be a str, not {dimension.__class__.__name__}"
            )
        mip_level_count = int(mip_level_count or 1)
        sample_count = int(sample_count or 1)

        n = len(view_formats)
        c_view_formats = <WGPUTextureFormat*>arena.alloc(n * sizeof(WGPUTextureFormat))
        for i in range(n):
            c_view_formats[i] = <WGPUTextureFormat>_enum("TextureFormat", view_formats[i])

        desc.label = arena.sv(label)
        desc.usage = usage
        desc.dimension = <WGPUTextureDimension>_enum("TextureDimension", dimension)
        desc.size.width = size[0]
        desc.size.height = size[1]
        desc.size.depthOrArrayLayers = size[2]
        desc.format = <WGPUTextureFormat>_enum("TextureFormat", format)
        desc.mipLevelCount = mip_level_count
        desc.sampleCount = sample_count
        desc.viewFormatCount = n
        desc.viewFormats = c_view_formats
        if texture_binding_view_dimension is not None:
            view_dim_desc.textureBindingViewDimension = <WGPUTextureViewDimension>_enum(
                "TextureViewDimension", texture_binding_view_dimension
            )
            desc.nextInChain = <WGPUChainedStruct*>&view_dim_desc

        texture = wgpuDeviceCreateTexture(<WGPUDevice>_self_ptr(self), &desc)
        _check()
        tex_info = {
            "size": size,
            "mip_level_count": mip_level_count,
            "sample_count": sample_count,
            "dimension": dimension,
            "format": format,
            "usage": usage,
            "texture_binding_view_dimension": texture_binding_view_dimension,
        }
        return GPUTexture(label, <uintptr_t>texture, self, tex_info)

    def create_sampler(
