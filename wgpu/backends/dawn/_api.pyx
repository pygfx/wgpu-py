cdef class _Handle:
    """Extension type that holds the native (Dawn) pointer of a GPU object.

    The public classes below inherit from this type *and* from the
    corresponding class in ``wgpu.classes``. The pointer is exposed to Python
    as ``_internal`` (an int, or None), for compatibility with the other backends.
    """

    cdef void* _ptr
    cdef int _kind  # a _KIND_X value to select the C function in mixins

    @property
    def _internal(self):
        if self._ptr == NULL:
            return None
        return <uintptr_t>self._ptr

    @_internal.setter
    def _internal(self, value):
        if value is None:
            self._ptr = NULL
        else:
            self._ptr = <void*><uintptr_t>value


# Kinds of objects, so the mixins can select the right C function without a dict lookup.
cdef enum:
    _KIND_OTHER = 0
    _KIND_COMMAND_ENCODER = 1
    _KIND_COMPUTE_PASS = 2
    _KIND_RENDER_PASS = 3
    _KIND_RENDER_BUNDLE_ENCODER = 4


cdef inline void* _ptr(object ob) except NULL:
    """Get the native pointer of a GPU object, raising if it's released/destroyed."""
    cdef void* p = (<_Handle?>ob)._ptr
    if p == NULL:
        _raise_released(ob)
    return p


cdef inline void* _self_ptr(object self) except NULL:
    """Like _ptr(), but without the type check (for self)."""
    cdef void* p = (<_Handle>self)._ptr
    if p == NULL:
        _raise_released(self)
    return p


cdef inline void* _ptr_or_null(object ob) except? NULL:
    if ob is None:
        return NULL
    return _ptr(ob)


cdef int _raise_released(object ob) except -1:
    raise RuntimeError(f"The {type(ob).__name__} object has been released.")


cdef inline WGPUStringView _null_sv() noexcept:
    cdef WGPUStringView v
    v.data = NULL
    v.length = WGPU_STRLEN
    return v


cdef inline WGPUStringView _sv(bytes b) noexcept:
    """Create a string view for the given bytes. The caller must keep b alive."""
    cdef WGPUStringView v
    if b is None:
        v.data = NULL
        v.length = WGPU_STRLEN
    else:
        v.data = <const char*>b
        v.length = len(b)
    return v


cdef inline bytes _encode(object s):
    if s is None:
        return None
    return (<str?>s).encode()


cdef str _from_sv(WGPUStringView v):
    if v.data == NULL:
        return ""
    if v.length == WGPU_STRLEN:
        return (<bytes>v.data).decode("utf-8", "ignore")
    return v.data[: v.length].decode("utf-8", "ignore")


cdef class _Arena:
    """Owns temporary C memory and Python objects (e.g. encoded strings) that
    must stay alive while Dawn consumes a descriptor. Freed when the arena
    goes out of scope (i.e. at the end of the calling function).
    """

    cdef void** _blocks
    cdef size_t _n
    cdef size_t _cap
    cdef list _keep

    def __cinit__(self):
        self._blocks = NULL
        self._n = 0
        self._cap = 0
        self._keep = []

    def __dealloc__(self):
        cdef size_t i
        for i in range(self._n):
            PyMem_Free(self._blocks[i])
        PyMem_Free(self._blocks)

    cdef void* alloc(self, size_t nbytes) except NULL:
        cdef void** new_blocks
        cdef void* p
        if self._n == self._cap:
            self._cap = self._cap * 2 + 8
            new_blocks = <void**>PyMem_Calloc(self._cap, sizeof(void*))
            if new_blocks == NULL:
                raise MemoryError()
            if self._blocks != NULL:
                memcpy(new_blocks, self._blocks, self._n * sizeof(void*))
                PyMem_Free(self._blocks)
            self._blocks = new_blocks
        p = PyMem_Calloc(1, nbytes if nbytes > 0 else 1)
        if p == NULL:
            raise MemoryError()
        self._blocks[self._n] = p
        self._n += 1
        return p

    cdef WGPUStringView sv(self, object s) except *:
        cdef bytes b
        if s is None:
            return _null_sv()
        b = (<str?>s).encode()
        self._keep.append(b)
        return _sv(b)


cdef class _Buffer:
    """Acquire a contiguous buffer from an object that supports the buffer protocol."""

    cdef Py_buffer view
    cdef bint acquired

    def __cinit__(self, object data, bint writable=False):
        cdef int flags = PyBUF_ANY_CONTIGUOUS
        self.acquired = False
        PyObject_GetBuffer(data, &self.view, flags)
        self.acquired = True

    def __dealloc__(self):
        if self.acquired:
            PyBuffer_Release(&self.view)


cdef int _enum(str enum_name, object value) except? -1:
    """Convert an enum string to its int value in Dawn.

    Like the wgpu-native backend, an int is passed through as the raw webgpu.h
    value (e.g. 0 for "undefined", i.e. the default).
    """
    if type(value) is int:
        return value
    try:
        return enummap[enum_name + "." + value]
    except KeyError:
        raise ValueError(f"Invalid value for {enum_name}: {value!r}") from None
    except TypeError:
        raise TypeError(f"{enum_name} must be a str, not {type(value).__name__}") from None


def _tuple_from_tuple_or_dict(ob, fields, defaults=()):
    """Given a tuple/list/dict, return a tuple. Also checks tuple size."""
    error_msg = "Expected tuple/key/dict with fields: {}"
    required = len(fields) - len(defaults)
    if isinstance(ob, (list, tuple)):
        fields_len = len(fields)
        ob_len = len(ob)
        if ob_len == fields_len:
            return tuple(ob)
        elif required <= ob_len < fields_len:
            defaults_needed = fields_len - ob_len
            return tuple((*ob, *defaults[-defaults_needed:]))
        else:
            raise ValueError(error_msg.format(", ".join(fields)))
    elif isinstance(ob, dict):
        if any(key not in fields for key in ob):
            raise ValueError("Unexpected key in {}".format(ob))
        try:
            return tuple(
                (
                    ob.get(key, defaults[index - required])
                    if index >= required
                    else ob[key]
                )
                for index, key in enumerate(fields)
            )
        except KeyError:
            raise ValueError(error_msg.format(", ".join(fields))) from None
    else:
        raise TypeError(error_msg.format(", ".join(fields)))


def _tuple_from_extent3d(size):
    return _tuple_from_tuple_or_dict(
        size, ("width", "height", "depth_or_array_layers"), (1, 1)
