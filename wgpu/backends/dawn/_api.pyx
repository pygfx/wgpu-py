cdef void _compilation_info_callback(
    WGPUCompilationInfoRequestStatus status,
    const WGPUCompilationInfo* info,
    void* userdata1,
    void* userdata2,
) noexcept with gil:
    cdef size_t i
    try:
        promise = _promise_from_userdata(userdata1)
        if status != WGPUCompilationInfoRequestStatus_Success or info == NULL:
            promise._wgpu_set_error(
                RuntimeError(f"Could not get compilation info ({<int>status}).")
            )
            return
        messages = []
        type_map = enum_int2str["CompilationMessageType"]
        for i in range(info.messageCount):
            m = info.messages[i]
            messages.append(
                GPUCompilationMessage(
                    _from_sv(m.message),
                    type_map.get(<int>m.type, "info"),
                    m.lineNum,
                    m.linePos,
                    m.offset,
                    m.length,
                )
            )
        promise._wgpu_set_input(GPUCompilationInfo(messages))
    except BaseException as err:  # no-cover
        _log_error(f"Error in compilation info callback: {err}")


