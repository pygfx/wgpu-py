    def create_shader_module(
        self, *, label: str = "", code, compilation_hints=()
    ) -> GPUShaderModule:
        cdef WGPUShaderModuleDescriptor desc = WGPU_SHADER_MODULE_DESCRIPTOR_INIT
        cdef WGPUShaderSourceWGSL wgsl = WGPU_SHADER_SOURCE_WGSL_INIT
        cdef WGPUShaderSourceSPIRV spirv = WGPU_SHADER_SOURCE_SPIRV_INIT
        cdef _Arena arena = _Arena()
        cdef WGPUShaderModule module
        cdef uint32_t* spirv_code

        if isinstance(code, str):
            looks_like_wgsl = any(x in code for x in ("@compute", "@vertex", "@fragment"))
            looks_like_glsl = code.lstrip().startswith("#version ")
            if looks_like_glsl and not looks_like_wgsl:
                raise ValueError("GLSL shaders are not supported by the Dawn backend.")
            wgsl.code = arena.sv(code)
            desc.nextInChain = <WGPUChainedStruct*>&wgsl
        elif isinstance(code, bytes):
            data = code
            if data[:4] != b"\x03\x02#\x07":
                raise ValueError("Given shader data does not look like a SpirV module")
            spirv_code = <uint32_t*>arena.alloc(len(data))
            memcpy(spirv_code, <const char*>data, len(data))
            spirv.codeSize = len(data) // 4
            spirv.code = spirv_code
            desc.nextInChain = <WGPUChainedStruct*>&spirv
        else:
            raise TypeError("Shader code must be str for WGSL, or bytes for SpirV.")

        desc.label = arena.sv(label)
        module = wgpuDeviceCreateShaderModule(<WGPUDevice>_self_ptr(self), &desc)
        _check()
        if module == NULL:
            raise RuntimeError("Shader module creation failed")
        return GPUShaderModule(label, <uintptr_t>module, self)

