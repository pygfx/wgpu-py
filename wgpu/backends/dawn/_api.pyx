        uint32_t instance_count=1,
        uint32_t first_vertex=0,
        uint32_t first_instance=0,
    ) -> None:
        cdef _Handle h = <_Handle>self
        cdef void* p = h._ptr
        if p == NULL:
            _raise_released(self)
        if h._kind == _KIND_RENDER_PASS:
            wgpuRenderPassEncoderDraw(
                <WGPURenderPassEncoder>p, vertex_count, instance_count, first_vertex, first_instance
            )
        else:
            wgpuRenderBundleEncoderDraw(
                <WGPURenderBundleEncoder>p, vertex_count, instance_count, first_vertex, first_instance
            )

    def draw_indirect(self, indirect_buffer, uint64_t indirect_offset) -> None:
        cdef _Handle h = <_Handle>self
