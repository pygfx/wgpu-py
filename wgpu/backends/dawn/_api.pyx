# The mixins below are shared by several encoder classes. They select the C
# function using the C-level ``_kind`` field, so no Python lookups are needed.


class GPUBindingCommandsMixin(classes.GPUBindingCommandsMixin):
    def set_bind_group(
        self,
        uint32_t index,
        bind_group,
        dynamic_offsets_data=(),
        dynamic_offsets_data_start=None,
        dynamic_offsets_data_length=None,
    ) -> None:
        cdef _Handle h = <_Handle>self
        cdef void* p = h._ptr
        cdef WGPUBindGroup bg = <WGPUBindGroup>_ptr_or_null(bind_group)
        cdef uint32_t offsets_stack[16]
        cdef uint32_t* offsets = offsets_stack
        cdef size_t n = 0
        cdef size_t i
        cdef _Arena arena
        if p == NULL:
            _raise_released(self)
        if dynamic_offsets_data is not None and len(dynamic_offsets_data) > 0:
            if (
                dynamic_offsets_data_start is not None
                or dynamic_offsets_data_length is not None
            ):
                if dynamic_offsets_data_start is None or dynamic_offsets_data_length is None:
                    raise ValueError(
                        "Dynamic offsets start and length must be both set or both None."
                    )
                if dynamic_offsets_data_start < 0:
                    raise ValueError("Dynamic offsets start must be non-negative.")
                if dynamic_offsets_data_length < 0:
                    raise ValueError("Dynamic offsets length must be non-negative.")
                dynamic_offsets_data = dynamic_offsets_data[
                    dynamic_offsets_data_start : dynamic_offsets_data_start
                    + dynamic_offsets_data_length
                ]
            n = len(dynamic_offsets_data)
            if n > 16:
                arena = _Arena()
                offsets = <uint32_t*>arena.alloc(n * sizeof(uint32_t))
            for i in range(n):
                offsets[i] = dynamic_offsets_data[i]
        if h._kind == _KIND_RENDER_PASS:
            wgpuRenderPassEncoderSetBindGroup(<WGPURenderPassEncoder>p, index, bg, n, offsets)
        elif h._kind == _KIND_COMPUTE_PASS:
            wgpuComputePassEncoderSetBindGroup(<WGPUComputePassEncoder>p, index, bg, n, offsets)
        else:
            wgpuRenderBundleEncoderSetBindGroup(<WGPURenderBundleEncoder>p, index, bg, n, offsets)

    def _begin_pipeline_statistics_query(self, query_set, query_index):
        raise RuntimeError("Pipeline statistics queries are not supported by Dawn.")

    def _end_pipeline_statistics_query(self):
        raise RuntimeError("Pipeline statistics queries are not supported by Dawn.")

    def set_immediates(self, range_offset, data, data_offset=0, data_size=None) -> None:
        cdef _Handle h = <_Handle>self
        cdef void* p = _self_ptr(self)
        cdef _Buffer buf = _Buffer(data)
        cdef Py_ssize_t nbytes = buf.view.len
        cdef Py_ssize_t offset = int(data_offset)
        cdef Py_ssize_t size = nbytes - offset if data_size is None else int(data_size)
        if not (0 <= offset < nbytes):
            raise ValueError("Invalid data_offset")
        if not (0 <= size <= nbytes):
            raise ValueError("Invalid data_size")
        if size + offset > nbytes:
            raise ValueError("data_size + data_offset is too large")
        cdef const char* c_data = <const char*>buf.view.buf + offset
        if h._kind == _KIND_RENDER_PASS:
            wgpuRenderPassEncoderSetImmediates(<WGPURenderPassEncoder>p, range_offset, c_data, size)
        elif h._kind == _KIND_COMPUTE_PASS:
            wgpuComputePassEncoderSetImmediates(<WGPUComputePassEncoder>p, range_offset, c_data, size)
        else:
            wgpuRenderBundleEncoderSetImmediates(<WGPURenderBundleEncoder>p, range_offset, c_data, size)


class GPUDebugCommandsMixin(classes.GPUDebugCommandsMixin):
    def push_debug_group(self, group_label: str) -> None:
        cdef _Handle h = <_Handle>self
        cdef void* p = _self_ptr(self)
        label_b = _encode(group_label)
        cdef WGPUStringView label = _sv(label_b)
        if h._kind == _KIND_RENDER_PASS:
            wgpuRenderPassEncoderPushDebugGroup(<WGPURenderPassEncoder>p, label)
        elif h._kind == _KIND_COMPUTE_PASS:
            wgpuComputePassEncoderPushDebugGroup(<WGPUComputePassEncoder>p, label)
        elif h._kind == _KIND_COMMAND_ENCODER:
            wgpuCommandEncoderPushDebugGroup(<WGPUCommandEncoder>p, label)
        else:
            wgpuRenderBundleEncoderPushDebugGroup(<WGPURenderBundleEncoder>p, label)
        _check()

    def pop_debug_group(self) -> None:
        cdef _Handle h = <_Handle>self
        cdef void* p = _self_ptr(self)
        if h._kind == _KIND_RENDER_PASS:
            wgpuRenderPassEncoderPopDebugGroup(<WGPURenderPassEncoder>p)
        elif h._kind == _KIND_COMPUTE_PASS:
            wgpuComputePassEncoderPopDebugGroup(<WGPUComputePassEncoder>p)
        elif h._kind == _KIND_COMMAND_ENCODER:
            wgpuCommandEncoderPopDebugGroup(<WGPUCommandEncoder>p)
        else:
            wgpuRenderBundleEncoderPopDebugGroup(<WGPURenderBundleEncoder>p)
        _check()

    def insert_debug_marker(self, marker_label: str) -> None:
        cdef _Handle h = <_Handle>self
        cdef void* p = _self_ptr(self)
        label_b = _encode(marker_label)
        cdef WGPUStringView label = _sv(label_b)
        if h._kind == _KIND_RENDER_PASS:
            wgpuRenderPassEncoderInsertDebugMarker(<WGPURenderPassEncoder>p, label)
        elif h._kind == _KIND_COMPUTE_PASS:
            wgpuComputePassEncoderInsertDebugMarker(<WGPUComputePassEncoder>p, label)
        elif h._kind == _KIND_COMMAND_ENCODER:
            wgpuCommandEncoderInsertDebugMarker(<WGPUCommandEncoder>p, label)
        else:
            wgpuRenderBundleEncoderInsertDebugMarker(<WGPURenderBundleEncoder>p, label)
        _check()

    def _write_timestamp(self, query_set, query_index):
        cdef _Handle h = <_Handle>self
        cdef void* p = _self_ptr(self)
        cdef WGPUQuerySet qs = <WGPUQuerySet>_ptr(query_set)
        if h._kind == _KIND_RENDER_PASS:
            wgpuRenderPassEncoderWriteTimestamp(<WGPURenderPassEncoder>p, qs, query_index)
        elif h._kind == _KIND_COMPUTE_PASS:
            wgpuComputePassEncoderWriteTimestamp(<WGPUComputePassEncoder>p, qs, query_index)
        elif h._kind == _KIND_COMMAND_ENCODER:
            wgpuCommandEncoderWriteTimestamp(<WGPUCommandEncoder>p, qs, query_index)
        else:
            raise RuntimeError(f"{type(self).__name__} does not implement write_timestamp")
        _check()


class GPURenderCommandsMixin(classes.GPURenderCommandsMixin):
    def set_pipeline(self, pipeline) -> None:
        cdef _Handle h = <_Handle>self
        cdef void* p = h._ptr
        cdef void* pipe = _ptr(pipeline)
        if p == NULL:
            _raise_released(self)
        if h._kind == _KIND_RENDER_PASS:
            wgpuRenderPassEncoderSetPipeline(<WGPURenderPassEncoder>p, <WGPURenderPipeline>pipe)
        else:
            wgpuRenderBundleEncoderSetPipeline(<WGPURenderBundleEncoder>p, <WGPURenderPipeline>pipe)

    def set_index_buffer(self, buffer, index_format, uint64_t offset=0, size=None) -> None:
        cdef _Handle h = <_Handle>self
        cdef void* p = _self_ptr(self)
        cdef WGPUBuffer buf = <WGPUBuffer>_ptr(buffer)
        cdef uint64_t c_size = size if size else WGPU_WHOLE_SIZE
        cdef WGPUIndexFormat fmt
        if index_format == "uint32":
            fmt = WGPUIndexFormat_Uint32
        elif index_format == "uint16":
            fmt = WGPUIndexFormat_Uint16
        else:
            fmt = <WGPUIndexFormat>_enum("IndexFormat", index_format)
        if h._kind == _KIND_RENDER_PASS:
            wgpuRenderPassEncoderSetIndexBuffer(<WGPURenderPassEncoder>p, buf, fmt, offset, c_size)
        else:
            wgpuRenderBundleEncoderSetIndexBuffer(<WGPURenderBundleEncoder>p, buf, fmt, offset, c_size)

    def set_vertex_buffer(self, uint32_t slot, buffer, uint64_t offset=0, size=None) -> None:
        cdef _Handle h = <_Handle>self
        cdef void* p = _self_ptr(self)
        cdef WGPUBuffer buf = <WGPUBuffer>_ptr_or_null(buffer)
        cdef uint64_t c_size = size if size else WGPU_WHOLE_SIZE
        if h._kind == _KIND_RENDER_PASS:
            wgpuRenderPassEncoderSetVertexBuffer(<WGPURenderPassEncoder>p, slot, buf, offset, c_size)
        else:
            wgpuRenderBundleEncoderSetVertexBuffer(<WGPURenderBundleEncoder>p, slot, buf, offset, c_size)

    def draw(
        self,
