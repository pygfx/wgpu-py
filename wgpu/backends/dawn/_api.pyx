def check_struct(struct_name, d):
    """Check that all keys in the given dict exist in the corresponding struct."""
    struct_class = getattr(structs, struct_name)
    if isinstance(d, struct_class):
        pass
    elif isinstance(d, dict):
        valid_keys = set(struct_class.__annotations__.keys())
        invalid_keys = set(d.keys()).difference(valid_keys)
        if invalid_keys:
            raise ValueError(f"Invalid keys in {struct_name}: {invalid_keys}")
    else:
        raise TypeError(f"Expecting {struct_name} or dict, but got {d!r}")


def to_snake_case(name, separator="_"):
    """Convert a name from camelCase to snake_case."""
    name2 = ""
    for c in name:
        c2 = c.lower()
        if c2 != c and len(name2) > 0:
            prev = name2[-1]
            if c2 == "d" and prev in "123":
                name2 = name2[:-1] + separator + prev
            elif prev != separator:
                name2 += separator
        name2 += c2
    return name2


# %% Error handling
#
# Dawn reports validation errors synchronously via the uncaptured-error
# callback, while the offending API call is running. The callback stores the
# error and sets a C flag; after each API call we check that flag (which costs
# virtually nothing) and raise the error as a Python exception at the call site.
#
# In Pyodide, the same holds if the WebGPU implementation reports the error
# during the call (as Dawn in Node.js does). In the browser, errors are reported
# asynchronously (via the uncapturederror event), after the call that caused
# them has returned. Therefore we also schedule a call (on the event loop) to
# log errors that have not been raised by then.


cdef bint _error_pending = False
_pending_errors = []
_error_message_counts = {}


cdef void _uncaptured_error_callback(
    const WGPUDevice* device,
    WGPUErrorType type,
    WGPUStringView message,
    void* userdata1,
    void* userdata2,
) noexcept with gil:
    global _error_pending
    try:
        error_type = enum_int2str["ErrorType"].get(<int>type, "Unknown")
        msg = _from_sv(message)
        msg = "\n".join(line.rstrip() for line in msg.splitlines())
        _pending_errors.append((error_type, msg))
        _error_pending = True
        if _IS_EMSCRIPTEN:
            _schedule_log_pending_errors()
    except BaseException:  # no-cover
        pass


_log_scheduled = False


def _schedule_log_pending_errors():
    global _log_scheduled
    if not _log_scheduled:
        import asyncio

        _log_scheduled = True
        asyncio.get_event_loop().call_soon(_log_pending_errors_soon)


def _log_pending_errors_soon():
    global _log_scheduled
    _log_scheduled = False
    _log_pending_errors()


def _log_error(message):
    """Log an error message, avoiding spamming the same message over and over."""
    h = hash("".join(c for c in message if not c.isdigit()))
    count = _error_message_counts.get(h, 0) + 1
    _error_message_counts[h] = count
    if count == 1:
        logger.error(message)
    elif count < 10:
        logger.error(message.splitlines()[0] + f" ({count})")
    elif count == 10:
        logger.error(message.splitlines()[0] + " (hiding from now)")


cdef int _raise_pending_error() except -1:
    global _error_pending
    errors = list(_pending_errors)
    _pending_errors.clear()
    _error_pending = False
    if not errors:
        return 0
    for _, msg in errors[1:]:
        _log_error(msg)
    error_type, msg = errors[0]
    cls = ERROR_TYPES.get(error_type, GPUError)
    raise cls(msg)


cdef inline int _check() except -1:
    """Raise a pending error (that occurred during the last API call)."""
    if _error_pending:
        _raise_pending_error()
    return 0


cdef void _log_pending_errors() noexcept:
    """Log pending errors instead of raising them (e.g. in release methods)."""
    global _error_pending
    if _error_pending:
        _error_pending = False
        try:
            errors = list(_pending_errors)
            _pending_errors.clear()
            for _, msg in errors:
                _log_error(msg)
        except BaseException:  # no-cover
            pass


cdef void _device_lost_callback(
    const WGPUDevice* device,
    WGPUDeviceLostReason reason,
    WGPUStringView message,
    void* userdata1,
    void* userdata2,
) noexcept with gil:
    # Note that this may be called from another thread.
    try:
        promise = _promise_from_userdata(userdata1)
        reason_str = enum_int2str["DeviceLostReason"].get(<int>reason, "unknown")
        msg = _from_sv(message)
        if reason not in (
            WGPUDeviceLostReason_Destroyed,  # explicit destroy is not an error
            WGPUDeviceLostReason_CallbackCancelled,  # e.g. at shutdown
        ):
            _log_error(f"The WGPU device was lost ({reason_str}):\n{msg}")
        promise._wgpu_set_input(GPUDeviceLostInfo(reason_str, msg))
    except BaseException:  # no-cover
        pass


cdef void _logging_callback(
    WGPULoggingType type, WGPUStringView message, void* userdata1, void* userdata2
) noexcept with gil:
    try:
        msg = _from_sv(message)
        if type == WGPULoggingType_Error:
            logger.error(msg)
        elif type == WGPULoggingType_Warning:
            logger.warning(msg)
        elif type == WGPULoggingType_Info:
            logger.info(msg)
        else:
            logger.debug(msg)
    except BaseException:  # no-cover
        pass


# %% Instance and events


cdef WGPUInstance _instance = NULL


cdef WGPUInstance _get_instance() except NULL:
    """Get the global Dawn instance."""
    global _instance
    cdef WGPUInstanceDescriptor desc
    cdef WGPUInstanceFeatureName features[2]
    cdef size_t n = 0
    if _instance == NULL:
        desc = WGPU_INSTANCE_DESCRIPTOR_INIT
        # TimedWaitAny allows us to block on futures (sync_wait). Not in the browser.
        if not _IS_EMSCRIPTEN:
            features[n] = WGPUInstanceFeatureName_TimedWaitAny
            n += 1
        if wgpuHasInstanceFeature(WGPUInstanceFeatureName_ShaderSourceSPIRV):
            features[n] = WGPUInstanceFeatureName_ShaderSourceSPIRV
            n += 1
        desc.requiredFeatureCount = n
        desc.requiredFeatures = features
        _instance = wgpuCreateInstance(&desc)
        if _instance == NULL:
            raise RuntimeError("Could not create Dawn WebGPU instance.")
    return _instance


def get_instance_address():
    """Get the address of the global WGPUInstance (for interop)."""
    return <uintptr_t>_get_instance()


cdef int _wait_future(uint64_t future_id) except -1:
    """Block until the future completes, with the GIL released. Native only."""
    cdef WGPUFutureWaitInfo info
    cdef WGPUWaitStatus status
    cdef WGPUInstance instance = _get_instance()
    info.future.id = future_id
    info.completed = False
    while True:
        with nogil:
            status = wgpuInstanceWaitAny(instance, 1, &info, 100_000_000)  # 0.1 s
        if status == WGPUWaitStatus_Success or info.completed:
            break
        elif status == WGPUWaitStatus_TimedOut:
            continue  # allows KeyboardInterrupt to come through between waits
        else:
            raise RuntimeError(f"Waiting for future failed with status {<int>status}")
    _check()
    return 0


def process_events():
    """Process pending Dawn events, which may resolve pending GPUPromises.

    This is called automatically when awaiting a promise, and by the
    event pump when callbacks (via ``promise.then()``) are used. In the browser
    this is not needed, because callbacks are called by the JS event loop.
    """
    wgpuInstanceProcessEvents(_get_instance())
    _check()


class _EventPump:
    """Calls ``process_events()`` on the event loop's thread while promises are pending.

    Dawn objects are not thread-safe (unless the ImplicitDeviceSynchronization
    feature is used), so we never call into Dawn from a background thread.
    Instead, a lightweight thread periodically schedules a call to
    ``process_events()`` in the event loop, using its ``call_soon_threadsafe()``.
    """

    def __init__(self):
        self._lock = threading.Lock()
        self._promises = set()
        self._thread = None

    def add(self, promise):
        if promise._call_soon_threadsafe is None:
            return
        with self._lock:
            self._promises.add(promise)
            if self._thread is None:
                self._thread = threading.Thread(target=self._run, daemon=True)
                self._thread.start()

    def _run(self):
        sleep_gen = get_backoff_time_generator()
        while True:
            with self._lock:
                self._promises = {p for p in self._promises if p._state == "pending"}
                if not self._promises:
                    self._thread = None
                    return
                call_soons = {p._call_soon_threadsafe for p in self._promises}
            for call_soon in call_soons:
                try:
                    call_soon(_process_events_safe)
                except Exception:
                    pass  # e.g. loop is closed
            time.sleep(max(0.001, next(sleep_gen)))


def _process_events_safe():
    try:
        process_events()
    except Exception as err:
        _log_error(str(err))


_event_pump = _EventPump()


class GPUPromise(classes.GPUPromise):
    """GPUPromise for Dawn futures.

    Natively, ``sync_wait()`` blocks on the future via ``wgpuInstanceWaitAny``
    (with the GIL released), and awaiting polls ``wgpuInstanceProcessEvents``.

    In the browser, the callbacks are called by the JS event loop, so awaiting is
    plain asyncio. A sync wait must let the JS event loop run while the Python
    stack is suspended, which Pyodide supports via JSPI (``pyodide.ffi.run_sync``)
    when the code is run with e.g. ``pyodide.runPythonAsync()``.
    """

    _future_id = 0

    def _set_future(self, uint64_t future_id):
        self._future_id = future_id
        if not _IS_EMSCRIPTEN:
            _event_pump.add(self)

    def _sync_wait(self):
        if _IS_EMSCRIPTEN:
            from pyodide.ffi import run_sync, can_run_sync

            if not can_run_sync():
                raise RuntimeError(
                    "Cannot sync-wait for a GPUPromise in Pyodide here: this needs "
                    "JSPI support and code that is run via e.g. pyodide.runPythonAsync(). "
                    "Use the async API (await) instead."
                )
            run_sync(self._wait_web())
        elif self._future_id:
            _wait_future(self._future_id)
        if self._state == "pending":
            # Should not happen, but avoid hanging forever
            raise RuntimeError(f"Promise {self._title!r} did not resolve.")

    async def _wait_web(self):
        # The callback is called from the JS event loop, and (via call_soon)
        # sets the async event. Without a loop, poll the state instead.
        if self._call_soon_threadsafe is not None:
            with self._lock:
                if self._async_event is None:
                    self._async_event = AsyncEvent()
                    if self._state != "pending":
                        self._async_event.set()
            await self._async_event.wait()
        else:
            while self._state == "pending":
                await async_sleep(0.001)

    def __await__(self):
        if self._state == "pending" and self._future_id and not _IS_EMSCRIPTEN:

            async def awaiter():
                sleep_gen = get_backoff_time_generator()
                while self._state == "pending":
                    process_events()
                    if self._state != "pending":
                        break
                    await async_sleep(next(sleep_gen))
                return self._resolve()

            return (yield from awaiter().__await__())
        return (yield from super().__await__())


cdef inline void* _promise_userdata(object promise):
    """Get a pointer to pass as userdata. The callback must call _promise_from_userdata."""
    Py_INCREF(promise)
    return <void*>promise


cdef inline object _promise_from_userdata(void* userdata):
    promise = <object>userdata
    Py_DECREF(promise)  # balance the incref in _promise_userdata
    return promise


cdef void _request_adapter_callback(
    WGPURequestAdapterStatus status,
    WGPUAdapter adapter,
    WGPUStringView message,
    void* userdata1,
    void* userdata2,
) noexcept with gil:
    try:
        promise = _promise_from_userdata(userdata1)
        if status != WGPURequestAdapterStatus_Success or adapter == NULL:
            msg = _from_sv(message)
            promise._wgpu_set_error(
                RuntimeError(f"Request adapter failed ({<int>status}): {msg}")
            )
        else:
            promise._wgpu_set_input(<uintptr_t>adapter)
    except BaseException as err:  # no-cover
        _log_error(f"Error in request_adapter callback: {err}")


