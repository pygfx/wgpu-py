    def create_bind_group_layout(self, *, label: str = "", entries) -> GPUBindGroupLayout:
        cdef WGPUBindGroupLayoutDescriptor desc = WGPU_BIND_GROUP_LAYOUT_DESCRIPTOR_INIT
        cdef _Arena arena = _Arena()
        cdef WGPUBindGroupLayoutEntry* c_entries
        cdef WGPUBindGroupLayoutEntry* c_entry
        cdef WGPUBindGroupLayout layout
        cdef size_t i
        cdef size_t n = len(entries)

        c_entries = <WGPUBindGroupLayoutEntry*>arena.alloc(n * sizeof(WGPUBindGroupLayoutEntry))
        for i in range(n):
            entry = entries[i]
            check_struct("BindGroupLayoutEntry", entry)
            c_entry = &c_entries[i]
            c_entry[0] = WGPU_BIND_GROUP_LAYOUT_ENTRY_INIT
            buffer = entry.get("buffer")
            sampler = entry.get("sampler")
            texture = entry.get("texture")
            storage_texture = entry.get("storage_texture")
            if buffer is not None:  # Note, it might be an empty dictionary
                info = buffer
                check_struct("BufferBindingLayout", info)
                min_binding_size = info.get("min_binding_size", None)
                if min_binding_size is None:
                    min_binding_size = 0
                c_entry.buffer.type = <WGPUBufferBindingType>_enum(
                    "BufferBindingType", info.get("type", "uniform")
                )
                c_entry.buffer.hasDynamicOffset = bool(info.get("has_dynamic_offset", False))
                c_entry.buffer.minBindingSize = min_binding_size
            elif sampler is not None:
                info = sampler
                check_struct("SamplerBindingLayout", info)
                c_entry.sampler.type = <WGPUSamplerBindingType>_enum(
                    "SamplerBindingType", info.get("type", "filtering")
                )
            elif texture is not None:
                info = texture
                check_struct("TextureBindingLayout", info)
                view_dimension = info.get("view_dimension", "2d")
                if not isinstance(view_dimension, str):
                    raise TypeError(
                        f"Texture view dimension must be a str, not {view_dimension.__class__.__name__}"
                    )
                c_entry.texture.sampleType = <WGPUTextureSampleType>_enum(
                    "TextureSampleType", info.get("sample_type", "float")
                )
                c_entry.texture.viewDimension = <WGPUTextureViewDimension>_enum(
                    "TextureViewDimension", view_dimension
                )
                c_entry.texture.multisampled = bool(info.get("multisampled", False))
            elif storage_texture is not None:
                info = storage_texture
                check_struct("StorageTextureBindingLayout", info)
                view_dimension = info.get("view_dimension", "2d")
                if not isinstance(view_dimension, str):
                    raise TypeError(
                        f"Texture view dimension must be a str, not {view_dimension.__class__.__name__}"
                    )
                c_entry.storageTexture.access = <WGPUStorageTextureAccess>_enum(
                    "StorageTextureAccess", info.get("access", "write-only")
                )
                c_entry.storageTexture.format = <WGPUTextureFormat>_enum(
                    "TextureFormat", info["format"]
                )
                c_entry.storageTexture.viewDimension = <WGPUTextureViewDimension>_enum(
                    "TextureViewDimension", view_dimension
                )
            else:
                raise ValueError(
                    "Bind group layout entry did not contain field 'buffer', 'sampler', 'texture', nor 'storage_texture'"
                )
            visibility = entry["visibility"]
            if isinstance(visibility, str):
                visibility = str_flag_to_int(flags.ShaderStage, visibility)
            c_entry.binding = int(entry["binding"])
            c_entry.visibility = int(visibility)

        desc.label = arena.sv(label)
        desc.entryCount = n
        desc.entries = c_entries
        layout = wgpuDeviceCreateBindGroupLayout(<WGPUDevice>_self_ptr(self), &desc)
        _check()
        return GPUBindGroupLayout(label, <uintptr_t>layout, self)

    def create_bind_group(self, *, label: str = "", layout, entries) -> GPUBindGroup:
        cdef WGPUBindGroupDescriptor desc = WGPU_BIND_GROUP_DESCRIPTOR_INIT
        cdef _Arena arena = _Arena()
        cdef WGPUBindGroupEntry* c_entries
        cdef WGPUBindGroupEntry* c_entry
        cdef WGPUBindGroup bind_group
        cdef size_t i
        cdef size_t n = len(entries)

        c_entries = <WGPUBindGroupEntry*>arena.alloc(n * sizeof(WGPUBindGroupEntry))
        for i in range(n):
            entry = entries[i]
            check_struct("BindGroupEntry", entry)
            c_entry = &c_entries[i]
            c_entry[0] = WGPU_BIND_GROUP_ENTRY_INIT
            c_entry.binding = int(entry["binding"])
            resource = entry["resource"]
            if isinstance(resource, GPUBuffer):
                c_entry.buffer = <WGPUBuffer>_ptr(resource)
                c_entry.offset = 0
                c_entry.size = resource.size
            elif isinstance(resource, GPUSampler):
                c_entry.sampler = <WGPUSampler>_ptr(resource)
            elif isinstance(resource, GPUTextureView):
                c_entry.textureView = <WGPUTextureView>_ptr(resource)
            elif isinstance(resource, (structs.BufferBinding, dict)):
                c_entry.buffer = <WGPUBuffer>_ptr(resource["buffer"])
                c_entry.offset = resource.get("offset", 0)
                size = resource.get("size", None)
                c_entry.size = WGPU_WHOLE_SIZE if size is None else size
