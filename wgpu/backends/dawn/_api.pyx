cdef int _fill_timestamp_writes(WGPUPassTimestampWrites* tw, timestamp_writes) except -1:
    tw[0] = WGPU_PASS_TIMESTAMP_WRITES_INIT
    tw.querySet = <WGPUQuerySet>_ptr(timestamp_writes["query_set"])
    tw.beginningOfPassWriteIndex = timestamp_writes.get(
        "beginning_of_pass_write_index", WGPU_QUERY_SET_INDEX_UNDEFINED
    )
    tw.endOfPassWriteIndex = timestamp_writes.get(
        "end_of_pass_write_index", WGPU_QUERY_SET_INDEX_UNDEFINED
    )
    return 0


cdef int _fill_texel_copy_texture_info(WGPUTexelCopyTextureInfo* info, d) except -1:
    info[0] = WGPU_TEXEL_COPY_TEXTURE_INFO_INIT
    texture = d["texture"]
    if isinstance(texture, GPUTextureView):
        raise ValueError("copy texture must be a texture, not a view")
    info.texture = <WGPUTexture>_ptr(texture)
    info.mipLevel = int(d.get("mip_level", 0))
    ori = _tuple_from_origin3d(d)
    info.origin.x = ori[0]
    info.origin.y = ori[1]
    info.origin.z = ori[2]
    info.aspect = <WGPUTextureAspect>_enum("TextureAspect", d.get("aspect", "all"))
    return 0


cdef int _fill_extent(WGPUExtent3D* extent, size) except -1:
    size = _tuple_from_extent3d(size)
    extent.width = size[0]
    extent.height = size[1]
    extent.depthOrArrayLayers = size[2]
    return 0


class GPUCommandEncoder(
    classes.GPUCommandEncoder, GPUCommandsMixin, GPUDebugCommandsMixin, GPUObjectBase
):
    _handle_kind = _KIND_COMMAND_ENCODER

    def _release_ptr(self, ptr):
        wgpuCommandEncoderRelease(<WGPUCommandEncoder><uintptr_t>ptr)

    def begin_compute_pass(self, *, label: str = "", timestamp_writes=None) -> GPUComputePassEncoder:
        cdef WGPUComputePassDescriptor desc = WGPU_COMPUTE_PASS_DESCRIPTOR_INIT
        cdef WGPUPassTimestampWrites tw
        cdef WGPUComputePassEncoder encoder
        cdef bytes label_b
        if label:
            label_b = _encode(label)
            desc.label = _sv(label_b)
        if timestamp_writes is not None:
            check_struct("ComputePassTimestampWrites", timestamp_writes)
            _fill_timestamp_writes(&tw, timestamp_writes)
            desc.timestampWrites = &tw
        encoder = wgpuCommandEncoderBeginComputePass(<WGPUCommandEncoder>_self_ptr(self), &desc)
        _check()
        return GPUComputePassEncoder(label, <uintptr_t>encoder, self._device)

    def begin_render_pass(
        self,
        *,
        label: str = "",
        color_attachments,
        depth_stencil_attachment=None,
        occlusion_query_set=None,
        timestamp_writes=None,
        max_draw_count: int = 50000000,
    ) -> GPURenderPassEncoder:
        cdef WGPURenderPassDescriptor desc = WGPU_RENDER_PASS_DESCRIPTOR_INIT
        cdef WGPURenderPassMaxDrawCount max_draw = WGPU_RENDER_PASS_MAX_DRAW_COUNT_INIT
        cdef WGPUPassTimestampWrites tw
        cdef WGPURenderPassColorAttachment color_stack[8]
        cdef WGPURenderPassColorAttachment* c_colors = color_stack
        cdef WGPURenderPassColorAttachment* c_color
        cdef WGPURenderPassDepthStencilAttachment c_ds = WGPU_RENDER_PASS_DEPTH_STENCIL_ATTACHMENT_INIT
        cdef WGPURenderPassEncoder encoder
        cdef _Arena arena
        cdef size_t i
        cdef size_t n = len(color_attachments)
        cdef bytes label_b

        if label:
            label_b = _encode(label)
            desc.label = _sv(label_b)
        if timestamp_writes is not None:
            check_struct("RenderPassTimestampWrites", timestamp_writes)
            _fill_timestamp_writes(&tw, timestamp_writes)
            desc.timestampWrites = &tw

        if n > 8:
            arena = _Arena()
            c_colors = <WGPURenderPassColorAttachment*>arena.alloc(n * sizeof(WGPURenderPassColorAttachment))
        for i in range(n):
            color_attachment = color_attachments[i]
            c_color = &c_colors[i]
            c_color[0] = WGPU_RENDER_PASS_COLOR_ATTACHMENT_INIT
            if color_attachment is None:
                continue  # sparse attachments: view stays NULL
            check_struct("RenderPassColorAttachment", color_attachment)
            texture_view = color_attachment["view"]
            if not isinstance(texture_view, GPUTextureView):
                raise TypeError("Color attachment view must be a GPUTextureView.")
            c_color.view = <WGPUTextureView>_ptr(texture_view)
            c_color.resolveTarget = <WGPUTextureView>_ptr_or_null(
                color_attachment.get("resolve_target", None)
            )
            depth_slice = color_attachment.get("depth_slice", None)
            if depth_slice is not None:
                c_color.depthSlice = depth_slice
            c_color.loadOp = <WGPULoadOp>_enum("LoadOp", color_attachment["load_op"])
            c_color.storeOp = <WGPUStoreOp>_enum("StoreOp", color_attachment["store_op"])
            clear_value = color_attachment.get("clear_value", (0, 0, 0, 0))
            if isinstance(clear_value, dict):
                check_struct("Color", clear_value)
                clear_value = _tuple_from_color(clear_value)
            c_color.clearValue.r = clear_value[0]
            c_color.clearValue.g = clear_value[1]
            c_color.clearValue.b = clear_value[2]
            c_color.clearValue.a = clear_value[3]
        desc.colorAttachmentCount = n
        desc.colorAttachments = c_colors

        if depth_stencil_attachment is not None:
            check_struct("RenderPassDepthStencilAttachment", depth_stencil_attachment)
            self._fill_depth_stencil_attachment(depth_stencil_attachment, <uintptr_t>&c_ds)
            desc.depthStencilAttachment = &c_ds

        if occlusion_query_set is not None:
            desc.occlusionQuerySet = <WGPUQuerySet>_ptr(occlusion_query_set)

        if max_draw_count != 50000000:
            max_draw.maxDrawCount = max_draw_count
            desc.nextInChain = <WGPUChainedStruct*>&max_draw

        encoder = wgpuCommandEncoderBeginRenderPass(<WGPUCommandEncoder>_self_ptr(self), &desc)
        _check()
        return GPURenderPassEncoder(label, <uintptr_t>encoder, self._device)

    def _fill_depth_stencil_attachment(self, ds_attachment, uintptr_t address):
        cdef WGPURenderPassDepthStencilAttachment* c_ds = <WGPURenderPassDepthStencilAttachment*>address
        view = ds_attachment["view"]
        c_ds.view = <WGPUTextureView>_ptr(view)
        texture_format = view.texture.format
        depth_keys_okay = stencil_keys_okay = False
        if "depth" in texture_format:
            depth_read_only = ds_attachment.get("depth_read_only", False)
            c_ds.depthReadOnly = bool(depth_read_only)
            if not depth_read_only:
                depth_keys_okay = True
                depth_load_op = ds_attachment["depth_load_op"]
                c_ds.depthLoadOp = <WGPULoadOp>_enum("LoadOp", depth_load_op)
                c_ds.depthStoreOp = <WGPUStoreOp>_enum("StoreOp", ds_attachment["depth_store_op"])
                if depth_load_op == "clear":
                    c_ds.depthClearValue = float(ds_attachment["depth_clear_value"])
        if "stencil" in texture_format:
            stencil_read_only = ds_attachment.get("stencil_read_only", False)
            c_ds.stencilReadOnly = bool(stencil_read_only)
            if not stencil_read_only:
                stencil_keys_okay = True
                c_ds.stencilLoadOp = <WGPULoadOp>_enum("LoadOp", ds_attachment["stencil_load_op"])
                c_ds.stencilStoreOp = <WGPUStoreOp>_enum("StoreOp", ds_attachment["stencil_store_op"])
                c_ds.stencilClearValue = int(ds_attachment.get("stencil_clear_value", 0))
        unexpected_keys = [
            *(("depth_load_op", "depth_store_op") if not depth_keys_okay else ()),
            *(("stencil_load_op", "stencil_store_op") if not stencil_keys_okay else ()),
        ]
        for key in unexpected_keys:
            if ds_attachment.get(key) is not None:
                if not getattr(self._device, f"warned_about_{key}", False):
                    logger.warning(f"Unexpected key {key} in depth_stencil_attachment")
                    setattr(self._device, f"warned_about_{key}", True)

    def clear_buffer(self, buffer, offset: int = 0, size: int | None = None) -> None:
        offset = int(offset)
        if offset % 4 != 0:
            raise ValueError("offset must be a multiple of 4")
        if size is not None:
            size = int(size)
            if size <= 0:
                raise ValueError("size must be > 0")
            if size % 4 != 0:
                raise ValueError("size must be a multiple of 4")
            if offset + size > buffer.size:
                raise ValueError("buffer size out of range")
        else:
            size = WGPU_WHOLE_SIZE
            if offset > buffer.size:
                raise ValueError("offset is too large")
        wgpuCommandEncoderClearBuffer(
            <WGPUCommandEncoder>_self_ptr(self), <WGPUBuffer>_ptr(buffer), offset, size
        )
        _check()

    def copy_buffer_to_buffer(
        self, source, source_offset, destination, destination_offset, size=None
    ) -> None:
        if source_offset % 4 != 0:
            raise ValueError("source_offset must be a multiple of 4")
        if destination_offset % 4 != 0:
            raise ValueError("destination_offset must be a multiple of 4")
        if size is None:
            size = WGPU_WHOLE_SIZE
        elif size % 4 != 0:
            raise ValueError("size must be a multiple of 4")
        if not isinstance(source, GPUBuffer):
            raise TypeError("copy_buffer_to_buffer() source must be a GPUBuffer.")
        if not isinstance(destination, GPUBuffer):
            raise TypeError("copy_buffer_to_buffer() destination must be a GPUBuffer.")
        wgpuCommandEncoderCopyBufferToBuffer(
            <WGPUCommandEncoder>_self_ptr(self),
            <WGPUBuffer>_ptr(source),
            int(source_offset),
            <WGPUBuffer>_ptr(destination),
            int(destination_offset),
            int(size),
        )
        _check()

    def copy_buffer_to_texture(self, source, destination, copy_size) -> None:
        cdef WGPUTexelCopyBufferInfo c_source = WGPU_TEXEL_COPY_BUFFER_INFO_INIT
        cdef WGPUTexelCopyTextureInfo c_destination
        cdef WGPUExtent3D c_size
        check_struct("TexelCopyBufferInfo", source)
        check_struct("TexelCopyTextureInfo", destination)
        row_alignment = 256
        bytes_per_row = int(source["bytes_per_row"])
        if (bytes_per_row % row_alignment) != 0:
            raise ValueError(
                f"bytes_per_row ({bytes_per_row}) must be a multiple of {row_alignment}"
            )
        size = _tuple_from_extent3d(copy_size)
        c_source.layout.offset = int(source.get("offset", 0))
        c_source.layout.bytesPerRow = bytes_per_row
        c_source.layout.rowsPerImage = int(source.get("rows_per_image", size[1]))
        c_source.buffer = <WGPUBuffer>_ptr(source["buffer"])
        _fill_texel_copy_texture_info(&c_destination, destination)
        _fill_extent(&c_size, size)
        wgpuCommandEncoderCopyBufferToTexture(
            <WGPUCommandEncoder>_self_ptr(self), &c_source, &c_destination, &c_size
        )
        _check()

    def copy_texture_to_buffer(self, source, destination, copy_size) -> None:
        cdef WGPUTexelCopyTextureInfo c_source
        cdef WGPUTexelCopyBufferInfo c_destination = WGPU_TEXEL_COPY_BUFFER_INFO_INIT
        cdef WGPUExtent3D c_size
        check_struct("TexelCopyTextureInfo", source)
        check_struct("TexelCopyBufferInfo", destination)
        row_alignment = 256
        bytes_per_row = int(destination["bytes_per_row"])
        if (bytes_per_row % row_alignment) != 0:
            raise ValueError(
                f"bytes_per_row must ({bytes_per_row}) be a multiple of {row_alignment}"
            )
        size = _tuple_from_extent3d(copy_size)
        _fill_texel_copy_texture_info(&c_source, source)
        c_destination.layout.offset = int(destination.get("offset", 0))
        c_destination.layout.bytesPerRow = bytes_per_row
        c_destination.layout.rowsPerImage = int(destination.get("rows_per_image", size[1]))
        c_destination.buffer = <WGPUBuffer>_ptr(destination["buffer"])
        _fill_extent(&c_size, size)
        wgpuCommandEncoderCopyTextureToBuffer(
            <WGPUCommandEncoder>_self_ptr(self), &c_source, &c_destination, &c_size
        )
