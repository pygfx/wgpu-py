cdef inline dict limits_to_dict(const WGPULimits* c):
    """Convert a WGPULimits struct to a dict with wgpu-py limit names."""
    return {
        "max-texture-dimension-1d": c.maxTextureDimension1D,
        "max-texture-dimension-2d": c.maxTextureDimension2D,
        "max-texture-dimension-3d": c.maxTextureDimension3D,
        "max-texture-array-layers": c.maxTextureArrayLayers,
        "max-bind-groups": c.maxBindGroups,
        "max-bind-groups-plus-vertex-buffers": c.maxBindGroupsPlusVertexBuffers,
        "max-bindings-per-bind-group": c.maxBindingsPerBindGroup,
        "max-dynamic-uniform-buffers-per-pipeline-layout": c.maxDynamicUniformBuffersPerPipelineLayout,
        "max-dynamic-storage-buffers-per-pipeline-layout": c.maxDynamicStorageBuffersPerPipelineLayout,
        "max-sampled-textures-per-shader-stage": c.maxSampledTexturesPerShaderStage,
        "max-samplers-per-shader-stage": c.maxSamplersPerShaderStage,
        "max-storage-buffers-per-shader-stage": c.maxStorageBuffersPerShaderStage,
        "max-storage-textures-per-shader-stage": c.maxStorageTexturesPerShaderStage,
        "max-uniform-buffers-per-shader-stage": c.maxUniformBuffersPerShaderStage,
